---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);

const projects = (await reader.collections.projects.all()).sort(
  (a, b) =>
    (a.entry.order ?? 0) - (b.entry.order ?? 0) ||
    a.entry.title.localeCompare(b.entry.title)
);

const studies = (await reader.collections.studies.all()).sort(
  (a, b) =>
    (a.entry.order ?? 0) - (b.entry.order ?? 0) ||
    a.entry.title.localeCompare(b.entry.title)
);

const statusLabel = {
  ongoing: "Ongoing",
  completed: "Completed",
};
---

<Layout title="Research — Health Inequalities Team">
  <section class="section">
    <div class="container-page max-w-4xl">
      <h1>Our research</h1>
      <p class="mt-5 max-w-2xl leading-7 text-muted">
        Explore the Health Inequalities Team's major research programmes and individual studies.
      </p>

      <div class="mt-12">
        <p class="eyebrow">Projects in HIT</p>

        {
          projects.length === 0 ? (
            <p class="mt-6 text-muted">No projects have been added yet.</p>
          ) : (
            <nav class="project-title-list mt-5" aria-label="Projects in HIT">
              {projects.map((project) => (
                <a href={`/projects/${project.slug}`} class="project-title-link">
                  <span>{project.entry.title}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14m0 0-5-5m5 5-5 5" />
                  </svg>
                </a>
              ))}
            </nav>
          )
        }
      </div>
    </div>
  </section>

  <section class="studies-section on-dark" aria-labelledby="studies-heading">
    <div class="container-page">
      <p class="eyebrow studies-eyebrow">Our work in depth</p>
      <h2 id="studies-heading" class="mt-3">Studies</h2>
      <p class="mt-4 max-w-2xl leading-7 text-white/75">
        Discover the individual studies through which we investigate and address health inequalities.
      </p>

      {
        studies.length === 0 ? (
          <p class="mt-10 text-white/75">
            Studies will appear here when they are added in Keystatic.
          </p>
        ) : (
          <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {studies.map((study) => {
              const href = study.entry.externalLink || `/studies/${study.slug}`;
              const isExternal = Boolean(study.entry.externalLink);

              return (
                <a
                  href={href}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  class="study-card group"
                >
                  {study.entry.coverImage && (
                    <img
                      src={study.entry.coverImage}
                      alt=""
                      class="study-card-image"
                    />
                  )}

                  <div class="study-card-content">
                    <div class="flex flex-wrap items-center gap-3 text-xs text-white/70">
                      <span class="study-status">{statusLabel[study.entry.status]}</span>
                      {study.entry.timeframe && <span>{study.entry.timeframe}</span>}
                    </div>

                    <h3 class="mt-4 text-xl text-white">{study.entry.title}</h3>
                    <p class="mt-3 flex-1 leading-7 text-white/75">{study.entry.summary}</p>

                    <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-white">
                      View study
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14m0 0-5-5m5 5-5 5" />
                      </svg>
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </section>
</Layout>
