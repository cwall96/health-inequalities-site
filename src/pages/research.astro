---
import { createReader } from "@keystatic/core/reader";
import { DocumentRenderer } from "@keystatic/core/renderer";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const siteContent = await reader.singletons.home.read();
const team = await reader.collections.team.all();
const teamBySlug = new Map(team.map((person) => [person.slug, person.entry.name]));
const linkedPeople = (slugs: readonly (string | null)[] = []) =>
  slugs.flatMap((slug) => {
    if (!slug) return [];
    const name = teamBySlug.get(slug);
    return name ? [{ slug, name }] : [];
  });

const themeEntries = (await reader.collections.researchThemes.all()).sort(
  (a, b) =>
    (a.entry.order ?? 0) - (b.entry.order ?? 0) ||
    a.entry.name.localeCompare(b.entry.name)
);

const projects = (await reader.collections.projects.all()).sort(
  (a, b) =>
    (a.entry.order ?? 0) - (b.entry.order ?? 0) ||
    a.entry.title.localeCompare(b.entry.title)
);

const projectsWithContent = await Promise.all(
  projects.map(async (project) => ({
    ...project,
    document: await project.entry.content(),
  }))
);

const studies = (await reader.collections.studies.all()).filter(({ slug }) => slug !== "study-2").sort(
  (a, b) =>
    (a.entry.order ?? 0) - (b.entry.order ?? 0) ||
    a.entry.title.localeCompare(b.entry.title)
);

const studyDocuments = await Promise.all(studies.map((study) => study.entry.content()));

const usedThemeSlugs = new Set(
  studies.flatMap((study) => study.entry.researchThemes ?? []).filter(Boolean)
);
const themes = themeEntries.filter((theme) => usedThemeSlugs.has(theme.slug));

const statusLabel = {
  ongoing: "Ongoing",
  completed: "Completed",
};
---

<Layout title="Research — Health Inequalities Team">
  <section class="section page-intro-section">
    <div class="container-page max-w-5xl">
<div class="page-intro max-w-2xl">
  <h1>Our research</h1>

  <p class="page-intro-copy mt-5 leading-7">
    Explore the Health Inequalities Team's research programmes and studies.
  </p>
</div>

<div
  id="research-programmes"
  class="mt-12 grid gap-10 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16"
>
  <div>
    <p class="eyebrow">Research programmes</p>

    <p class="mt-5 leading-7 text-muted">
      {
        siteContent?.projectDescription ||
          "Add your project description in Keystatic."
      }
    </p>
  </div>

  <div>
    {
      projectsWithContent.length === 0 ? (
        <p class="text-muted">No research programmes have been added yet.</p>
      ) : (
        <div class="research-programme-list">
          {projectsWithContent.map((project) => (
            <article class="research-programme" id={`project-${project.slug}`}>
              <div class="flex flex-wrap items-center gap-3 text-sm">
                <span class={`project-status project-status-${project.entry.status}`}>
                  {statusLabel[project.entry.status]}
                </span>
                {project.entry.timeframe && <span class="text-muted">{project.entry.timeframe}</span>}
              </div>

              <h2 class="mt-4 text-2xl">{project.entry.title}</h2>
              <p class="mt-4 leading-7 text-ink">{project.entry.summary}</p>

              {(project.entry.lead || project.entry.funder) && (
                <p class="mt-4 text-sm leading-6 text-muted">
                  {[project.entry.lead && `Led by ${project.entry.lead}`, project.entry.funder && `Funded by ${project.entry.funder}`]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
              )}

              {linkedPeople(project.entry.teamMembers).length > 0 && (
                <div class="content-people-links">
                  <span>Project team</span>
                  <div>
                    {linkedPeople(project.entry.teamMembers).map((person) => (
                      <a href={`/people/${person.slug}`}>{person.name}</a>
                    ))}
                  </div>
                </div>
              )}

              {project.entry.website && (
                <a
                  href={project.entry.website}
                  class="btn-secondary mt-5 inline-flex"
                >
                  {project.entry.websiteLabel?.trim() || "Find out more"}
                  <span aria-hidden="true">→</span>
                </a>
              )}

              {project.document.length > 0 && (
                <article class="article research-programme-content">
                  <DocumentRenderer document={project.document} />
                </article>
              )}
            </article>
          ))}
        </div>
      )
    }
  </div>
</div>

    </div>
  </section>

  <section
    class="studies-section on-dark"
    aria-labelledby="studies-heading">
    <div class="container-page">
      <div id="research-themes" class="research-theme-filter">
        <div>
          <p class="eyebrow studies-eyebrow">Research themes</p>
          <h2 class="mt-3 text-2xl text-white">Explore studies by theme</h2>
          <p class="mt-3 max-w-2xl leading-7 text-white/75">
            Choose a theme to show the studies connected to that area of work.
          </p>
        </div>

        <div class="research-theme-options" aria-label="Filter studies by research theme">
          <button type="button" class="research-theme-button is-active" data-theme-filter="" aria-pressed="true">
            All studies
          </button>
          {themes.map((theme) => (
            <button
              type="button"
              class="research-theme-button"
              data-theme-filter={theme.slug}
              aria-pressed="false"
            >
              {theme.entry.name}
            </button>
          ))}
        </div>
      </div>

      <p class="eyebrow studies-eyebrow">Our work in depth</p>
      <h2 id="studies-heading" class="mt-3">Studies</h2>
      <p class="mt-4 max-w-2xl leading-7 text-white/75">
        Discover the studies through which we investigate and address health inequalities.
      </p>

      {
        studies.length === 0 ? (
          <p class="mt-10 text-white/75">
            Studies will appear here when they are added in Keystatic.
          </p>
        ) : (
          <div class="mt-8 divide-y divide-white/25" data-study-grid>
            {studies.map((study, index) => (
              <article
                id={`study-${study.slug}`}
                class="scroll-mt-24 py-8"
                data-study-card
                data-study-themes={JSON.stringify(study.entry.researchThemes ?? [])}
              >
                <p class="text-sm text-white/75">
                  {[statusLabel[study.entry.status], study.entry.timeframe].filter(Boolean).join(" · ")}
                </p>
                <h3 class="mt-2 text-2xl text-white">{study.entry.title}</h3>
                <p class="mt-3 max-w-3xl text-lg text-white">{study.entry.summary}</p>
                <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/85">
                  {study.entry.lead && <span>Led by {study.entry.lead}</span>}
                  {study.entry.funder && <span>Funded by {study.entry.funder}</span>}
                </div>
                {[study.entry.whyItMatters, study.entry.approach, study.entry.contribution, study.entry.impact].map((section) => (
                  section?.body && (
                    <div class="mt-5 max-w-3xl">
                      <h4 class="text-white">{section.heading}</h4>
                      {section.body.split(/\n\s*\n/).map((paragraph) => (
                        <p class="mt-2 whitespace-pre-line leading-7 text-white/85">{paragraph}</p>
                      ))}
                    </div>
                  )
                ))}
                {studyDocuments[index].length > 0 && (
                  <div class="article mt-5 max-w-3xl text-white [&_a]:text-white [&_h2]:text-white [&_p]:text-white">
                    <DocumentRenderer document={studyDocuments[index]} />
                  </div>
                )}
                {study.entry.externalLink && (
                  <a class="mt-4 inline-block text-white underline" href={study.entry.externalLink}>Study website</a>
                )}
              </article>
            ))}
          </div>
        )
      }

      <p class="study-filter-empty" data-study-filter-empty hidden>
        No studies are currently assigned to this research theme.
      </p>
    </div>
  </section>

  <script>
    const themeButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-filter]")];
    const studyCards = [...document.querySelectorAll<HTMLElement>("[data-study-card]")];
    const emptyMessage = document.querySelector<HTMLElement>("[data-study-filter-empty]");
    const studyReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    themeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selectedTheme = button.dataset.themeFilter ?? "";
        let visible = 0;

        studyCards.forEach((card) => {
          const cardThemes = JSON.parse(card.dataset.studyThemes ?? "[]") as string[];
          const matches = !selectedTheme || cardThemes.includes(selectedTheme);
          card.hidden = !matches;

          if (matches) {
            card.classList.remove("is-filter-entering");
            card.style.setProperty("--study-filter-index", String(visible));

            if (!studyReducedMotion) {
              void card.offsetWidth;
              card.classList.add("is-filter-entering");
              card.addEventListener(
                "animationend",
                () => card.classList.remove("is-filter-entering"),
                { once: true }
              );
            }

            visible += 1;
          }
        });

        themeButtons.forEach((themeButton) => {
          const isActive = themeButton === button;
          themeButton.classList.toggle("is-active", isActive);
          themeButton.setAttribute("aria-pressed", String(isActive));
        });

        if (emptyMessage) emptyMessage.hidden = visible !== 0;
      });
    });
  </script>
</Layout>
