---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import PersonCard from "../components/PersonCard.astro";

const reader = createReader(process.cwd(), keystaticConfig);

const team = (await reader.collections.team.all()).sort(
  (a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0)
);

/*
 * Clare is displayed separately as the team lead.
 * Everyone else is shown in the team grid.
 */
const teamLead =
  team.find((person) => person.slug === "clare-bambra") ?? team[0];

const otherTeamMembers = team.filter(
  (person) => person.slug !== teamLead?.slug
);

const filters = [
  { value: "all", label: "All" },
  { value: "staff", label: "Staff" },
  { value: "phd", label: "PhD students" },
  { value: "services", label: "Professional services" },
];

const getInitials = (name: string) =>
  name
    .split(" ")
    .map((word) => word[0])
    .slice(0, 2)
    .join("");
    
export const prerender = true;
---

<Layout title="People — Health Inequalities Team">
  <section class="section">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">The team</p>

        <h1 class="mt-3">Meet our people</h1>

        <p class="mx-auto mt-4 max-w-2xl text-muted">
          Meet the researchers and professional services staff working together
          to understand and reduce health inequalities.
        </p>
      </div>

      {
        team.length === 0 ? (
          <p class="mt-10 text-center text-muted">
            No people yet. Add team members in the editor at{" "}
            <code>/keystatic</code>.
          </p>
        ) : (
          <>
            {
              teamLead && (
                <div class="mt-12">
                  <p class="mb-4 text-center text-sm font-medium uppercase tracking-wider text-muted">
                    Team lead
                  </p>

                  <a
                    href={`/people/${teamLead.slug}`}
                    class="team-lead-card mx-auto flex max-w-2xl flex-col items-center gap-5 rounded-2xl border border-line bg-white p-7 text-center no-underline transition-all duration-200 hover:-translate-y-1 hover:shadow-pop sm:flex-row sm:text-left"
                  >
                    {
                      teamLead.entry.photo ? (
                        <img
                          src={teamLead.entry.photo}
                          alt={teamLead.entry.name}
                          class="h-28 w-28 shrink-0 rounded-full object-cover ring-4 ring-red-50"
                        />
                      ) : (
                        <span class="flex h-28 w-28 shrink-0 items-center justify-center rounded-full bg-red-50 text-2xl font-medium text-red-700">
                          {getInitials(teamLead.entry.name)}
                        </span>
                      )
                    }

                    <div>
                      <h2 class="text-2xl text-ink">
                        {teamLead.entry.name}
                      </h2>

                      <p class="mt-1 text-muted">
                        {teamLead.entry.role}
                      </p>

                      <p class="mt-4 text-sm font-medium text-red-700">
                        View profile →
                      </p>
                    </div>
                  </a>

                  <div
                    class="team-connector mx-auto hidden max-w-4xl lg:block"
                    aria-hidden="true"
                  >
                    <div class="mx-auto h-8 w-px bg-line"></div>
                    <div class="h-px w-full bg-line"></div>
                    <div class="grid grid-cols-3">
                      <div class="mx-auto h-6 w-px bg-line"></div>
                      <div class="mx-auto h-6 w-px bg-line"></div>
                      <div class="mx-auto h-6 w-px bg-line"></div>
                    </div>
                  </div>
                </div>
              )
            }

            <div class="mt-10 lg:mt-2">
              <h2 class="text-center">Our team</h2>

              <div
                class="mt-6 flex flex-wrap justify-center gap-2"
                id="filters"
                aria-label="Filter team members"
              >
                {
                  filters.map((filter, index) => (
                    <button
                      class={index === 0 ? "chip-active" : "chip"}
                      data-filter={filter.value}
                      type="button"
                    >
                      {filter.label}
                    </button>
                  ))
                }
              </div>

              <div
                class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
                id="grid"
              >
                {
                  otherTeamMembers.map((person) => (
                    <PersonCard
                      slug={person.slug}
                      name={person.entry.name}
                      role={person.entry.role}
                      category={person.entry.category}
                      photo={person.entry.photo}
                    />
                  ))
                }
              </div>

              <p
                id="no-results"
                class="mt-10 hidden text-center text-muted"
              >
                There are no team members in this category yet.
              </p>
            </div>
          </>
        )
      }
    </div>
  </section>
</Layout>

<script>
  const filterBar = document.getElementById("filters");

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("#grid [data-category]")
  );

  const noResults = document.getElementById("no-results");

  filterBar?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-filter]"
    );

    if (!button) return;

    const selectedFilter = button.dataset.filter;

    filterBar.querySelectorAll("[data-filter]").forEach((item) => {
      item.className = "chip";
    });

    button.className = "chip-active";

    let visibleCards = 0;

    cards.forEach((card) => {
      const shouldShow =
        selectedFilter === "all" ||
        card.dataset.category === selectedFilter;

      card.style.display = shouldShow ? "" : "none";

      if (shouldShow) {
        visibleCards += 1;
      }
    });

    noResults?.classList.toggle("hidden", visibleCards !== 0);
  });
</script>