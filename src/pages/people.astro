---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import PersonCard from "../components/PersonCard.astro";

const reader = createReader(process.cwd(), keystaticConfig);

const team = (await reader.collections.team.all()).sort(
  (a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0)
);

const teamLead = team.find(
  (person) => person.slug === "clare-bambra"
);

const groupedTeam = team.filter(
  (person) => person.slug !== teamLead?.slug
);

/*
 * Existing profiles may still use the old "staff" category.
 * This keeps everyone in the correct section until their
 * category is updated through Keystatic.
 */
const seniorFallbackSlugs = new Set([
  "adam-todd",
  "anna-robinson-barella",
  "courtney-mcnamara",
  "laura-woods",
  "sarah-sowden",
  "shelina-visram",
  "steph-scott",
  "vic-mcgowan",
  "viviana-albani",
]);

const getDisplayGroup = (person: (typeof team)[number]) => {
  /*
   * Victoria is displayed as a senior team member even if
   * her Keystatic category has not been updated yet.
   */
  if (person.slug === "victoria-morgan") {
    return "senior";
  }

  if (person.entry.category !== "staff") {
    return person.entry.category;
  }

  if (person.slug === "donna-wakefield") {
    return "phd";
  }

  return seniorFallbackSlugs.has(person.slug)
    ? "senior"
    : "ecr";
};

const groups = [
  {
    value: "senior",
    heading: "Senior team members",
    description:
      "Senior academic, clinical and research colleagues.",
  },
  {
    value: "ecr",
    heading: "Early career researchers",
    description:
      "Researchers developing work across health inequalities.",
  },
  {
    value: "phd",
    heading: "PhD students",
    description:
      "Doctoral researchers working with the team.",
  },
];

export const prerender = true;
---

<Layout title="People — Health Inequalities Team">
  <section class="section">
    <div class="mx-auto w-full max-w-7xl px-6">
      {
        team.length === 0 ? (
          <div class="mx-auto max-w-3xl text-center">
            <p class="eyebrow">
              The team
            </p>

            <h1 class="mt-3">
              Meet the team
            </h1>

            <p class="mt-10 text-muted">
              No people yet. Add team members in the editor at{" "}
              <code>/keystatic</code>.
            </p>
          </div>
        ) : (
          <>
            <!-- Right-aligned page introduction -->
            <div class="ml-auto max-w-2xl text-right">
              <p class="eyebrow">
                The team
              </p>

              <h1 class="mt-3">
                Meet the team
              </h1>

              <p class="mt-4 text-lg leading-8 text-muted">
                Meet the researchers and professionals working
                together to understand and reduce health
                inequalities.
              </p>
            </div>

            <div class="mt-14 space-y-16">
              <!-- Team lead and Ridley Building image -->
              {
                teamLead && (
                  <section aria-labelledby="team-lead-heading">
                    <div
                      class="grid gap-7 lg:grid-cols-[10rem_minmax(0,1fr)] lg:gap-10"
                    >
                      <div>
                        <h2
                          id="team-lead-heading"
                          class="text-2xl text-ink"
                        >
                          Team lead
                        </h2>

                        <p class="mt-2 text-sm leading-6 text-muted">
                          Academic leadership for the team.
                        </p>
                      </div>

                      <div
                        class="grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3"
                      >
                        <PersonCard
                          slug={teamLead.slug}
                          name={teamLead.entry.name}
                          role={teamLead.entry.role}
                          category={teamLead.entry.category}
                          photo={teamLead.entry.photo}
                          email={teamLead.entry.email}
                          researchKeywords={
                            teamLead.entry.researchKeywords
                          }
                        />

                        <!-- Ridley Building picture card -->
                        <div
                          class="h-fulloverflow-hidden rounded-2xl border border-line bg-white shadow-card lg:col-span-2"
                        >
                          <img
                            src="/images/ridley.png"
                            alt="Ridley Building at Newcastle University"
                            class="h-full w-full object-cover"
                          />
                        </div>
                      </div>
                    </div>
                  </section>
                )
              }

              <!-- Senior, early-career and PhD sections -->
              {
                groups.map((group) => {
                  const members = groupedTeam.filter(
                    (person) =>
                      getDisplayGroup(person) === group.value
                  );

                  if (members.length === 0) {
                    return null;
                  }

                  return (
                    <section
                      aria-labelledby={`${group.value}-heading`}
                    >
                      <div
                        class="grid gap-7 lg:grid-cols-[10rem_minmax(0,1fr)] lg:gap-10"
                      >
                        <div>
                          <h2
                            id={`${group.value}-heading`}
                            class="text-2xl text-ink"
                          >
                            {group.heading}
                          </h2>

                          <p class="mt-2 text-sm leading-6 text-muted">
                            {group.description}
                          </p>
                        </div>

                        <div
                          class="grid items-start gap-6 sm:grid-cols-2 lg:grid-cols-3"
                        >
                          {
                            members.map((person) => (
                              <PersonCard
                                slug={person.slug}
                                name={person.entry.name}
                                role={person.entry.role}
                                category={getDisplayGroup(
                                  person
                                )}
                                photo={person.entry.photo}
                                email={person.entry.email}
                                researchKeywords={
                                  person.entry.researchKeywords
                                }
                              />
                            ))
                          }
                        </div>
                      </div>
                    </section>
                  );
                })
              }
            </div>
          </>
        )
      }
    </div>
  </section>
</Layout>