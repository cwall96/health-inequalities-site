---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";
import Layout from "../../layouts/Layout.astro";
import { teamPublications, type Pub } from "../../lib/publications";

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const team = await reader.collections.team.all();
  return team.map((p) => ({
    params: { slug: p.slug },
    props: { person: { slug: p.slug, ...p.entry } },
  }));
}

const { person } = Astro.props;

const pageReader = createReader(process.cwd(), keystaticConfig);
const [manualEntries, projectEntries, studyEntries, presentationEntries, impactEntries, recognitionEntries, teamEntries] = await Promise.all([
  pageReader.collections.publications.all(),
  pageReader.collections.projects.all(),
  pageReader.collections.studies.all(),
  pageReader.collections.presentations.all(),
  pageReader.collections.impacts.all(),
  pageReader.collections.recognition.all(),
  pageReader.collections.team.all(),
]);

const teamMemberNames = new Map(
  teamEntries.map((member) => [member.slug, member.entry.name])
);

const manualPublications: Pub[] = manualEntries
  .filter((publication) => publication.entry.teamMembers?.includes(person.slug))
  .map((publication) => ({
    title: publication.entry.title,
    year: publication.entry.year ?? null,
    doi: null,
    venue: publication.entry.venue ?? "",
    citations: 0,
    authors: publication.entry.authors ?? "",
    url: publication.entry.url ?? null,
    teamMembers: (publication.entry.teamMembers ?? []).filter(Boolean) as string[],
    researchThemes: (publication.entry.researchThemes ?? []).filter(Boolean) as string[],
  }));

const pubs: Pub[] = await teamPublications(
  person.identifier ? [person.identifier as string] : [],
  { manual: manualPublications }
);

const relatedProjects = projectEntries.filter((project) =>
  project.entry.teamMembers?.includes(person.slug)
);
const relatedStudies = studyEntries.filter((study) =>
  study.entry.teamMembers?.includes(person.slug)
);
const relatedPresentations = presentationEntries.filter((presentation) =>
  presentation.entry.teamMembers?.includes(person.slug)
);
const relatedImpacts = impactEntries.filter((impact) =>
  impact.entry.teamMembers?.includes(person.slug)
);
const relatedAwards = recognitionEntries.filter((award) =>
  award.entry.teamMembers?.includes(person.slug)
);

const byYear = new Map<number, Pub[]>();
for (const p of pubs) {
  const y = p.year ?? 0;
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const profilePublicationPageSize = 20;
const profilePublicationPageCount = Math.ceil(pubs.length / profilePublicationPageSize);
const firstProfilePublicationPage = new Set(pubs.slice(0, profilePublicationPageSize));

const initials = person.name
  .split(" ")
  .map((n: string) => n[0])
  .slice(0, 2)
  .join("");

const categoryLabels: Record<string, string> = {
  lead: "Team lead",
  senior: "Senior team member",
  ecr: "Early career researcher",
  phd: "PhD student",
  services: "Team administration",
  staff: "Team member",
};

const seniorFallbackSlugs = new Set([
  "adam-todd",
  "anna-robinson-barella",
  "courtney-mcnamara",
  "laura-woods",
  "sarah-sowden",
  "shelina-visram",
  "steph-scott",
  "vic-mcgowan",
  "victoria-morgan",
  "viviana-albani",
]);

const displayCategory = person.slug === "clare-bambra"
  ? "lead"
  : person.category !== "staff"
    ? person.category
    : person.slug === "donna-wakefield"
      ? "phd"
      : seniorFallbackSlugs.has(person.slug)
        ? "senior"
        : "ecr";

const emailCandidate = String(person.email || "").trim();
const email = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailCandidate)
  ? emailCandidate
  : null;

const summaryName = String(person.name || "").trim();
const fullDisplayName = String(person.displayName || "").trim();
const namePosition = fullDisplayName.indexOf(summaryName);
const summaryTitle = namePosition >= 0
  ? fullDisplayName.slice(0, namePosition).replace(/[,\s]+$/, "").trim()
  : "";
const summaryHeading = [summaryTitle, summaryName].filter(Boolean).join(" ");
const summaryCredentials = namePosition >= 0
  ? fullDisplayName
      .slice(namePosition + summaryName.length)
      .replace(/^[,\s]+/, "")
      .trim()
  : "";

const researchInterests = (person.researchKeywords ?? "")
  .split(",")
  .map((keyword: string) => keyword.trim())
  .filter(Boolean);

const methodsAndExpertise = (person.methodsExpertise ?? [])
  .filter(Boolean) as string[];

const qualificationLabels: Record<string, string> = {
  phd: "PhD",
  md: "MD",
  ma: "MA",
  msc: "MSc",
  mpharm: "MPharm",
  mph: "MPH",
  ba: "BA",
  bsc: "BSc",
  mbbs: "MBBS",
  undergraduate: "Other undergraduate",
  postgraduate: "Other postgraduate",
  other: "Other",
};

const professionalRoleTypeLabels: Record<string, string> = {
  leadership: "Leadership roles",
  research: "Research networks and collaborations",
  committee: "Committees and advisory roles",
  membership: "Professional memberships and fellowships",
  clinical: "Clinical roles",
  editorial: "Editorial roles",
  other: "Other roles",
};

const supervision = (person.supervision ?? []).filter(
  (entry) => entry.studentName || entry.projectTitle
);
const teaching = (person.teaching ?? []).filter((entry) => entry.course);
const researchActivities = (person.researchActivity ?? []).filter(
  (entry) => entry.projectTitle
);
const professionalRoles = (person.professionalRoles ?? []).filter(
  (entry) => entry.title
);

const professionalRoleGroups = Object.keys(professionalRoleTypeLabels)
  .map((type) => ({
    heading: professionalRoleTypeLabels[type],
    entries: professionalRoles.filter((entry) => (entry.type || "other") === type),
  }))
  .filter((group) => group.entries.length > 0);

const outputTypes = [
  { heading: "Posters", values: ["poster"] },
  { heading: "Presentations", values: ["conference", "inquiry"] },
  { heading: "Media coverage", values: ["media"] },
];

const activityOutputTypeLabels: Record<string, string> = {
  poster: "Poster",
  presentation: "Presentation",
  publication: "Publication",
  media: "Media coverage",
  other: "Output",
};

const relatedOutputGroups = outputTypes
  .map((group) => ({
    heading: group.heading,
    items: relatedPresentations.filter((presentation) =>
      group.values.includes(presentation.entry.section)
    ),
  }))
  .filter((group) => group.items.length > 0);

const orcidCandidate = String(person.orcid || person.identifier || "")
  .trim()
  .replace(/^https?:\/\/(?:www\.)?orcid\.org\//i, "");
const orcid = /^\d{4}-\d{4}-\d{4}-\d{3}[\dX]$/i.test(orcidCandidate)
  ? orcidCandidate.toUpperCase()
  : null;

const paragraphs = (copy: string) =>
  copy
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

const overviewParagraphs = [person.bio, person.researchFocus]
  .filter((copy): copy is string => Boolean(copy?.trim()))
  .flatMap((copy) => paragraphs(copy));

const hasResearchActivity =
  relatedStudies.length > 0 ||
  relatedProjects.length > 0 ||
  researchActivities.length > 0;
const hasImpactAndAwards = relatedImpacts.length > 0 || relatedAwards.length > 0;
const hasTeachingAndSupervision = teaching.length > 0 || supervision.length > 0;

const profileNavigation = [
  { href: "#overview", label: "Overview", show: overviewParagraphs.length > 0 },
  { href: "#research-activity", label: "Research activity", show: hasResearchActivity },
  { href: "#impact-and-awards", label: "Impact and awards", show: hasImpactAndAwards },
  { href: "#professional-roles", label: "Professional roles", show: professionalRoles.length > 0 },
  { href: "#teaching-and-supervision", label: "Teaching and supervision", show: hasTeachingAndSupervision },
  { href: "#skills", label: "Skills", show: methodsAndExpertise.length > 0 },
  { href: "#posters-presentations-media", label: "Posters, presentations and media", show: relatedPresentations.length > 0 },
  { href: "#publications", label: "Publications", show: true },
].filter((item) => item.show);

export const prerender = true;
---

<Layout title={`${person.name} — Health Inequalities Team`}>
  <section class="person-profile-section">
    <div class="container-page">
      <a href="/people" class="person-profile-back">← Back to people</a>

      <div class="person-profile-layout">
        <aside class="person-summary" aria-labelledby="person-summary-heading">
          {
            person.photo ? (
              <img src={person.photo} alt={person.name} class="person-summary-photo" />
            ) : (
              <span class="person-summary-placeholder" aria-hidden="true">
                {initials}
              </span>
            )
          }

          <h2 id="person-summary-heading">{summaryHeading}</h2>
          {summaryCredentials && (
            <p class="person-summary-credentials">{summaryCredentials}</p>
          )}

          {(email || orcid) && <dl class="person-summary-details">
            {email && (
              <div>
                <dt>Email</dt>
                <dd><a class="person-summary-email" href={`mailto:${email}`}>{email}</a></dd>
              </div>
            )}

            {orcid && (
              <div>
                <dt>ORCID iD</dt>
                <dd>
                  <a href={`https://orcid.org/${orcid}`} target="_blank" rel="noopener noreferrer">
                    {orcid}<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </dd>
              </div>
            )}
          </dl>}

          {researchInterests.length > 0 && (
            <div class="person-summary-interests">
              <h3>Main research themes</h3>
              <ul>
                {researchInterests.map((interest: string) => (
                  <li>{interest}</li>
                ))}
              </ul>
            </div>
          )}
        </aside>

        <main class="person-profile-main">
          <p class="eyebrow">
            {person.profileSubtitle?.trim() || categoryLabels[displayCategory] || "Team member"}
          </p>
          <h1>{person.name}</h1>
          <p class="person-profile-role">{person.role}</p>

          {overviewParagraphs.length > 0 && (
            <section id="overview" class="person-profile-introduction person-anchor-section" aria-labelledby="overview-heading">
              <h2 id="overview-heading">Overview</h2>
              <div class="person-profile-copy">
                {overviewParagraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </section>
          )}

          {hasResearchActivity && (
            <section id="research-activity" class="person-research-activity person-anchor-section" aria-labelledby="research-activity-heading">
              <div class="person-section-heading-row">
                <h2 id="research-activity-heading">Research activity</h2>
                <ul class="person-activity-key" aria-label="Study status key">
                  <li>
                    <span class="person-activity-status person-activity-status-ongoing" aria-hidden="true"></span>
                    Ongoing
                  </li>
                  <li>
                    <span class="person-activity-status person-activity-status-completed" aria-hidden="true"></span>
                    Completed
                  </li>
                </ul>
              </div>

              {relatedStudies.length > 0 && (
                <div class="person-profile-subsection">
                  <h3>Main studies</h3>
                  <ul class="person-activity-list">
                    {relatedStudies.map((study) => (
                      <li class="person-activity-item">
                        <span
                          class:list={[
                            "person-activity-status",
                            study.entry.status === "completed"
                              ? "person-activity-status-completed"
                              : "person-activity-status-ongoing",
                          ]}
                          aria-hidden="true"
                        ></span>
                        <a class="person-resource-link" href={`/studies/${study.slug}`}>
                          <span>
                            <strong>{study.entry.title}</strong>
                            {study.entry.peopleSummary && (
                              <small>{study.entry.peopleSummary}</small>
                            )}
                          </span>
                          <span class="person-resource-action">View study <span aria-hidden="true">→</span></span>
                          <p class="sr-only">
                            {study.entry.status === "completed" ? "Completed" : "Ongoing"} study.
                          </p>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {relatedProjects.length > 0 && (
                <div class="person-profile-subsection">
                  <h3>Research programmes</h3>
                  <ul class="person-compact-list">
                    {relatedProjects.map((project) => (
                      <li><a href={`/research#project-${project.slug}`}>{project.entry.title}</a></li>
                    ))}
                  </ul>
                </div>
              )}

              {researchActivities.length > 0 && (
                <div class="person-profile-subsection">
                  <h3>Other studies</h3>
                  <ul class="person-activity-list">
                    {researchActivities.map((activity) => (
                      <li class="person-activity-item">
                        <span
                          class:list={[
                            "person-activity-status",
                            activity.status === "completed"
                              ? "person-activity-status-completed"
                              : "person-activity-status-ongoing",
                          ]}
                          aria-hidden="true"
                        ></span>
                        <div>
                          <h4>{activity.projectTitle}</h4>
                          <p class="sr-only">
                            {activity.status === "completed" ? "Completed" : "Ongoing"} study.
                          </p>
                          {(activity.year || activity.funder) && (
                            <p class="person-activity-meta">
                              {[activity.year, activity.funder].filter(Boolean).join(" · ")}
                            </p>
                          )}
                          {activity.summary && <p class="person-activity-summary">{activity.summary}</p>}
                          {((activity.teamCollaborators ?? []).filter(Boolean).length > 0 ||
                            (activity.otherCollaborators ?? []).filter(Boolean).length > 0) && (
                            <div class="person-activity-collaborators">
                              <span>Collaborators:</span>
                              <div>
                                {(activity.teamCollaborators ?? []).filter(Boolean).map((slug) => (
                                  <a href={`/people/${slug}`}>
                                    {teamMemberNames.get(slug as string) ?? slug}
                                  </a>
                                ))}
                                {(activity.otherCollaborators ?? []).filter(Boolean).map((name) => (
                                  <span class="person-activity-external">{name}</span>
                                ))}
                              </div>
                            </div>
                          )}
                          {(activity.outputs ?? []).filter((output) => output.title && output.link).length > 0 && (
                            <ul class="person-study-output-list" aria-label={`Outputs linked to ${activity.projectTitle}`}>
                              {(activity.outputs ?? [])
                                .filter((output) => output.title && output.link)
                                .map((output) => (
                                  <li>
                                    <a href={output.link}>
                                      <span>{activityOutputTypeLabels[output.type] ?? "Output"}: {output.title}</span>
                                      <span aria-hidden="true">Open →</span>
                                    </a>
                                  </li>
                                ))}
                            </ul>
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          )}

          {hasImpactAndAwards && (
            <section id="impact-and-awards" class="person-profile-content person-compact-section person-anchor-section" aria-labelledby="impact-awards-heading">
              <h2 id="impact-awards-heading">Impact and awards</h2>
              {relatedImpacts.length > 0 && (
                <div class="person-profile-subsection">
                  <h3>Public and policy impact</h3>
                  <ul class="person-compact-list">
                    {relatedImpacts.map((impact) => (
                      <li>
                        <a href={`/presentations#impact-${impact.slug}`}><strong>{impact.entry.title}</strong></a>
                        {impact.entry.summary && <span>{impact.entry.summary}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {relatedAwards.length > 0 && (
                <div class="person-profile-subsection">
                  <h3>Awards and recognition</h3>
                  <ul class="person-compact-list">
                    {relatedAwards.map((award) => (
                      <li>
                        <a href={`/presentations#award-${award.slug}`}><strong>{award.entry.title}</strong></a>
                        <span>{[award.entry.awardingBody, award.entry.year].filter(Boolean).join(" · ")}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          )}

          {professionalRoles.length > 0 && (
            <section id="professional-roles" class="person-profile-content person-compact-section person-anchor-section" aria-labelledby="professional-roles-heading">
              <h2 id="professional-roles-heading">Professional roles and memberships</h2>
              {professionalRoleGroups.map((group) => (
                <div class="person-profile-subsection">
                  <h3>{group.heading}</h3>
                  <ul class="person-compact-list">
                    {group.entries.map((entry) => {
                      const dates = [entry.startYear, entry.endYear].filter(Boolean).join("–");
                      return (
                        <li>
                          <strong>{entry.title}</strong>
                          {(entry.organisation || dates) && (
                            <span>{[entry.organisation, dates].filter(Boolean).join(", ")}</span>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </section>
          )}

          {hasTeachingAndSupervision && (
            <section id="teaching-and-supervision" class="person-profile-content person-compact-section person-anchor-section" aria-labelledby="teaching-supervision-heading">
              <h2 id="teaching-supervision-heading">Teaching and supervision</h2>
              {teaching.length > 0 && (
                <div class="person-profile-subsection">
                  <h3>Teaching</h3>
                  <ul class="person-compact-list">
                    {teaching.map((entry) => {
                      const years = [entry.fromYear, entry.toYear]
                        .filter(Boolean)
                        .map((year) => year === "present" ? "Present" : year)
                        .join("–");
                      return (
                        <li>
                          <strong>{entry.course}</strong>
                          <span>
                            {[entry.module, qualificationLabels[entry.level] ?? entry.level, years]
                              .filter(Boolean)
                              .join(" · ")}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )}
              {supervision.length > 0 && (
                <div class="person-profile-subsection">
                  <h3>Supervision</h3>
                  <ul class="person-compact-list">
                    {supervision.map((entry) => {
                      const years = [entry.fromYear, entry.toYear]
                        .filter(Boolean)
                        .map((year) => year === "present" ? "Present" : year)
                        .join("–");
                      return (
                        <li>
                          <strong>{entry.studentName}</strong>
                          <span>
                            {[qualificationLabels[entry.qualification] ?? entry.qualification, entry.projectTitle, years]
                              .filter(Boolean)
                              .join(" · ")}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )}
            </section>
          )}

          {methodsAndExpertise.length > 0 && (
            <section id="skills" class="person-expertise person-anchor-section" aria-labelledby="expertise-heading">
              <h2 id="expertise-heading">Skills</h2>
              <div class="person-expertise-tags">
                {methodsAndExpertise.map((item: string) => (
                  <span class="person-expertise-tag">
                    {item}
                  </span>
                ))}
              </div>
            </section>
          )}

          {relatedPresentations.length > 0 && (
            <section id="posters-presentations-media" class="person-profile-content person-compact-section person-anchor-section" aria-labelledby="outputs-heading">
              <h2 id="outputs-heading">Posters, presentations and media</h2>
              {relatedOutputGroups.map((group) => (
                <div class="person-profile-subsection">
                  <h3>{group.heading}</h3>
                  <ul class="person-resource-list">
                    {group.items.map((item) => (
                      <li>
                        <a class="person-resource-link" href={item.entry.section === "poster" ? `/presentations/${item.slug}` : item.entry.link || "/presentations"}>
                          <span>
                            <strong>{item.entry.title}</strong>
                            {item.entry.peopleSummary && <small>{item.entry.peopleSummary}</small>}
                          </span>
                          <span class="person-resource-action">View details <span aria-hidden="true">→</span></span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>
          )}

          <section
            id="publications"
            class="person-publications person-anchor-section"
            aria-labelledby="publications-heading"
            data-profile-publications
          >
            <h2 id="publications-heading">Publications</h2>
            {
              pubs.length === 0 ? (
                <p class="mt-3 text-muted">No publications found for this person yet.</p>
              ) : (
                <div class="mt-6">
                  <p class="mb-5 text-sm text-muted" aria-live="polite" data-profile-publication-count>
                    Showing 1–{Math.min(profilePublicationPageSize, pubs.length)} of {pubs.length} publications
                  </p>
                  <div data-profile-publication-list>
                  {years.map((year) => (
                    <div
                      class="mb-6"
                      data-profile-year-group
                      hidden={!byYear.get(year)!.some((publication) => firstProfilePublicationPage.has(publication))}
                    >
                      <p class="mb-2 text-xs tracking-wide text-cloud-400">{year || "Undated"}</p>
                      {byYear.get(year)!.map((p) => (
                        <div
                          class="flex items-start justify-between gap-4 border-t border-line py-3"
                          data-profile-publication
                          hidden={!firstProfilePublicationPage.has(p)}
                        >
                          <div>
                            <p class="leading-6 text-ink">{p.title}</p>
                            <p class="text-sm text-muted">
                              {[p.venue].filter(Boolean).join(" · ")}
                              {p.citations > 0 && <span> · {p.citations} citations</span>}
                            </p>
                          </div>
                          {p.url && (
                            <a href={p.url} aria-label="Open publication">
                              <i class="ti ti-external-link text-lg text-muted" aria-hidden="true"></i>
                            </a>
                          )}
                        </div>
                      ))}
                    </div>
                  ))}
                  </div>

                  <nav
                    class="publication-pagination"
                    aria-label={`${person.name} publication pages`}
                    data-profile-publication-pagination
                    hidden={profilePublicationPageCount <= 1}
                  >
                    <button type="button" class="publication-page-direction" data-profile-page-previous disabled>
                      <span aria-hidden="true">←</span> Previous
                    </button>
                    <div class="publication-page-numbers">
                      {Array.from({ length: profilePublicationPageCount }, (_, index) => index + 1).map((page) => (
                        <button
                          type="button"
                          class:list={["publication-page-number", { "is-active": page === 1 }]}
                          data-profile-page-number={String(page)}
                          hidden={page > 3 && page < profilePublicationPageCount}
                          aria-current={page === 1 ? "page" : undefined}
                          aria-label={`Page ${page}`}
                        >
                          {page}
                        </button>
                      ))}
                    </div>
                    <button type="button" class="publication-page-direction" data-profile-page-next>
                      Next <span aria-hidden="true">→</span>
                    </button>
                  </nav>
                </div>
              )
            }
          </section>
        </main>

        <aside class="person-profile-navigation">
          <nav aria-label="Profile sections">
            <p>On this page</p>
            <ol>
              {profileNavigation.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ol>
          </nav>
        </aside>
      </div>
    </div>
  </section>

  <script>
    const publicationSection = document.querySelector<HTMLElement>("[data-profile-publications]");

    if (publicationSection) {
      const publications = [...publicationSection.querySelectorAll<HTMLElement>("[data-profile-publication]")];
      const yearGroups = [...publicationSection.querySelectorAll<HTMLElement>("[data-profile-year-group]")];
      const count = publicationSection.querySelector<HTMLElement>("[data-profile-publication-count]");
      const pagination = publicationSection.querySelector<HTMLElement>("[data-profile-publication-pagination]");
      const pageButtons = [...publicationSection.querySelectorAll<HTMLButtonElement>("[data-profile-page-number]")];
      const previousButton = publicationSection.querySelector<HTMLButtonElement>("[data-profile-page-previous]");
      const nextButton = publicationSection.querySelector<HTMLButtonElement>("[data-profile-page-next]");
      const publicationList = publicationSection.querySelector<HTMLElement>("[data-profile-publication-list]");
      const pageSize = 20;
      const pageCount = Math.max(1, Math.ceil(publications.length / pageSize));
      let currentPage = 1;

      const showPage = (page: number, moveFocus = false) => {
        currentPage = Math.min(Math.max(page, 1), pageCount);
        const firstIndex = (currentPage - 1) * pageSize;
        const lastIndex = Math.min(firstIndex + pageSize, publications.length);

        publications.forEach((publication, index) => {
          publication.hidden = index < firstIndex || index >= lastIndex;
        });
        yearGroups.forEach((group) => {
          group.hidden = !group.querySelector("[data-profile-publication]:not([hidden])");
        });

        if (count) count.textContent = `Showing ${firstIndex + 1}–${lastIndex} of ${publications.length} publications`;
        if (pagination) pagination.hidden = publications.length <= pageSize;
        if (previousButton) previousButton.disabled = currentPage === 1;
        if (nextButton) nextButton.disabled = currentPage === pageCount;
        pageButtons.forEach((button) => {
          const page = Number(button.dataset.profilePageNumber);
          const isActive = page === currentPage;
          const isUsefulPage =
            page === 1 ||
            page === pageCount ||
            Math.abs(page - currentPage) <= 1;
          button.hidden = !isUsefulPage;
          button.classList.toggle("is-active", isActive);
          if (isActive) button.setAttribute("aria-current", "page");
          else button.removeAttribute("aria-current");
        });

        if (moveFocus) publicationList?.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      pageButtons.forEach((button) => button.addEventListener("click", () => {
        showPage(Number(button.dataset.profilePageNumber), true);
      }));
      previousButton?.addEventListener("click", () => showPage(currentPage - 1, true));
      nextButton?.addEventListener("click", () => showPage(currentPage + 1, true));
    }
  </script>
</Layout>
