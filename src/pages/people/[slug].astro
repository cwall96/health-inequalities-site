---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";
import Layout from "../../layouts/Layout.astro";
import { teamPublications, type Pub } from "../../lib/publications";

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const team = await reader.collections.team.all();
  return team.map((p) => ({
    params: { slug: p.slug },
    props: { person: { slug: p.slug, ...p.entry } },
  }));
}

const { person } = Astro.props;

const pageReader = createReader(process.cwd(), keystaticConfig);
const [manualEntries, projectEntries, studyEntries, presentationEntries, impactEntries, recognitionEntries, teamEntries] = await Promise.all([
  pageReader.collections.publications.all(),
  pageReader.collections.projects.all(),
  pageReader.collections.studies.all(),
  pageReader.collections.presentations.all(),
  pageReader.collections.impacts.all(),
  pageReader.collections.recognition.all(),
  pageReader.collections.team.all(),
]);

const teamMemberNames = new Map(
  teamEntries.map((member) => [member.slug, member.entry.name])
);

const manualPublications: Pub[] = manualEntries
  .filter((publication) => publication.entry.teamMembers?.includes(person.slug))
  .map((publication) => ({
    title: publication.entry.title,
    year: publication.entry.year ?? null,
    doi: null,
    venue: publication.entry.venue ?? "",
    citations: 0,
    authors: publication.entry.authors ?? "",
    url: publication.entry.url ?? null,
    teamMembers: (publication.entry.teamMembers ?? []).filter(Boolean) as string[],
    researchThemes: (publication.entry.researchThemes ?? []).filter(Boolean) as string[],
  }));

const pubs: Pub[] = await teamPublications(
  person.identifier ? [person.identifier as string] : [],
  { manual: manualPublications }
);

const relatedProjects = projectEntries.filter((project) =>
  project.entry.teamMembers?.includes(person.slug)
);
const relatedStudies = studyEntries.filter((study) =>
  study.entry.teamMembers?.includes(person.slug)
);
const relatedPresentations = presentationEntries.filter((presentation) =>
  presentation.entry.teamMembers?.includes(person.slug)
);
const relatedImpacts = impactEntries.filter((impact) =>
  impact.entry.teamMembers?.includes(person.slug)
);
const relatedAwards = recognitionEntries.filter((award) =>
  award.entry.teamMembers?.includes(person.slug)
);
const hasRelatedWork =
  relatedProjects.length > 0 ||
  relatedStudies.length > 0 ||
  relatedPresentations.length > 0 ||
  relatedImpacts.length > 0 ||
  relatedAwards.length > 0;

const relatedWorkGroups = [
  {
    label: "Studies",
    items: relatedStudies.map((study) => ({
      title: study.entry.title,
      summary: study.entry.peopleSummary,
      href: `/studies/${study.slug}`,
    })),
  },
  {
    label: "Research programmes",
    items: relatedProjects.map((project) => ({
      title: project.entry.title,
      summary: null,
      href: `/research#project-${project.slug}`,
    })),
  },
  {
    label: "Posters, presentations and media",
    items: relatedPresentations.map((presentation) => ({
      title: presentation.entry.title,
      summary: presentation.entry.peopleSummary,
      href:
        presentation.entry.section === "poster"
          ? `/presentations/${presentation.slug}`
          : presentation.entry.link || "/presentations",
    })),
  },
  {
    label: "Public and policy impact",
    items: relatedImpacts.map((impact) => ({
      title: impact.entry.title,
      summary: impact.entry.summary,
      href: `/presentations#impact-${impact.slug}`,
    })),
  },
  {
    label: "Awards and recognition",
    items: relatedAwards.map((award) => ({
      title: award.entry.title,
      summary: null,
      href: `/presentations#award-${award.slug}`,
    })),
  },
].filter((group) => group.items.length > 0);

const byYear = new Map<number, Pub[]>();
for (const p of pubs) {
  const y = p.year ?? 0;
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const initials = person.name
  .split(" ")
  .map((n: string) => n[0])
  .slice(0, 2)
  .join("");

const categoryLabels: Record<string, string> = {
  lead: "Team lead",
  senior: "Senior team member",
  ecr: "Early career researcher",
  phd: "PhD student",
  services: "Team administration",
  staff: "Team member",
};

const seniorFallbackSlugs = new Set([
  "adam-todd",
  "anna-robinson-barella",
  "courtney-mcnamara",
  "laura-woods",
  "sarah-sowden",
  "shelina-visram",
  "steph-scott",
  "vic-mcgowan",
  "victoria-morgan",
  "viviana-albani",
]);

const displayCategory = person.slug === "clare-bambra"
  ? "lead"
  : person.category !== "staff"
    ? person.category
    : person.slug === "donna-wakefield"
      ? "phd"
      : seniorFallbackSlugs.has(person.slug)
        ? "senior"
        : "ecr";

const emailCandidate = String(person.email || "").trim();
const email = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailCandidate)
  ? emailCandidate
  : null;

const researchInterests = (person.researchKeywords ?? "")
  .split(",")
  .map((keyword: string) => keyword.trim())
  .filter(Boolean);

const methodsAndExpertise = (person.methodsExpertise ?? [])
  .filter(Boolean) as string[];

const qualificationLabels: Record<string, string> = {
  phd: "PhD",
  md: "MD",
  ma: "MA",
  msc: "MSc",
  mpharm: "MPharm",
  mph: "MPH",
  ba: "BA",
  bsc: "BSc",
  mbbs: "MBBS",
  undergraduate: "Other undergraduate",
  postgraduate: "Other postgraduate",
  other: "Other",
};

const professionalRoleTypeLabels: Record<string, string> = {
  leadership: "Leadership role",
  committee: "Committee or advisory role",
  membership: "Professional membership or fellowship",
  clinical: "Clinical role",
  editorial: "Editorial role",
  research: "Research network or collaboration",
  other: "Other role",
};

const supervision = (person.supervision ?? []).filter(
  (entry) => entry.studentName || entry.projectTitle
);
const teaching = (person.teaching ?? []).filter((entry) => entry.course);
const researchActivities = (person.researchActivity ?? []).filter(
  (entry) => entry.projectTitle
);
const professionalRoles = (person.professionalRoles ?? []).filter(
  (entry) => entry.title
);

const orcidCandidate = String(person.orcid || person.identifier || "")
  .trim()
  .replace(/^https?:\/\/(?:www\.)?orcid\.org\//i, "");
const orcid = /^\d{4}-\d{4}-\d{4}-\d{3}[\dX]$/i.test(orcidCandidate)
  ? orcidCandidate.toUpperCase()
  : null;

const profileSections = [
  { heading: "Research focus", copy: person.researchFocus },
].filter((section) => section.copy?.trim());

const paragraphs = (copy: string) =>
  copy
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

export const prerender = true;
---

<Layout title={`${person.name} — Health Inequalities Team`}>
  <section class="person-profile-section">
    <div class="container-page">
      <a href="/people" class="person-profile-back">← Back to people</a>

      <div class="person-profile-layout">
        <aside class="person-summary" aria-labelledby="person-summary-heading">
          {
            person.photo ? (
              <img src={person.photo} alt={person.name} class="person-summary-photo" />
            ) : (
              <span class="person-summary-placeholder" aria-hidden="true">
                {initials}
              </span>
            )
          }

          <h2 id="person-summary-heading">{person.displayName || person.name}</h2>

          {(email || orcid) && <dl class="person-summary-details">
            {email && (
              <div>
                <dt>Email</dt>
                <dd><a href={`mailto:${email}`}>{email}</a></dd>
              </div>
            )}

            {orcid && (
              <div>
                <dt>ORCID iD</dt>
                <dd>
                  <a href={`https://orcid.org/${orcid}`} target="_blank" rel="noopener noreferrer">
                    {orcid}<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </dd>
              </div>
            )}
          </dl>}

          {researchInterests.length > 0 && (
            <div class="person-summary-interests">
              <h3>Main research themes</h3>
              <ul>
                {researchInterests.map((interest: string) => (
                  <li>{interest}</li>
                ))}
              </ul>
            </div>
          )}
        </aside>

        <div class="person-profile-main">
          <p class="eyebrow">
            {person.profileSubtitle?.trim() || categoryLabels[displayCategory] || "Team member"}
          </p>
          <h1>{person.name}</h1>
          <p class="person-profile-role">{person.role}</p>

          {person.bio && (
            <section class="person-profile-introduction" aria-labelledby="profile-heading">
              <h2 id="profile-heading">Profile</h2>
              <div class="person-profile-copy">
                {paragraphs(person.bio).map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </section>
          )}

          {profileSections.length > 0 && (
            <div class="person-profile-sections">
              {profileSections.map((section, index) => (
                <section class="person-profile-content" aria-labelledby={`profile-section-${index}`}>
                  <h2 id={`profile-section-${index}`}>{section.heading}</h2>
                  <div class="person-profile-copy">
                    {paragraphs(section.copy).map((paragraph) => <p>{paragraph}</p>)}
                  </div>
                </section>
              ))}
            </div>
          )}

          {researchActivities.length > 0 && (
            <section class="person-research-activity" aria-labelledby="research-activity-heading">
              <h2 id="research-activity-heading">Research activity</h2>
              <ul class="person-activity-list">
                {researchActivities.map((activity) => (
                  <li class="person-activity-item">
                    <span
                      class:list={[
                        "person-activity-status",
                        activity.status === "completed"
                          ? "person-activity-status-completed"
                          : "person-activity-status-ongoing",
                      ]}
                      aria-hidden="true"
                    ></span>
                    <div>
                      <h3>{activity.projectTitle}</h3>
                      <p class="sr-only">
                        {activity.status === "completed" ? "Completed" : "Ongoing"} research activity.
                      </p>
                      {(activity.year || activity.funder) && (
                        <p class="person-activity-meta">
                          {[activity.year, activity.funder].filter(Boolean).join(" · ")}
                        </p>
                      )}
                      {activity.summary && <p class="person-activity-summary">{activity.summary}</p>}
                      {((activity.teamCollaborators ?? []).filter(Boolean).length > 0 ||
                        (activity.otherCollaborators ?? []).filter(Boolean).length > 0) && (
                        <div class="person-activity-collaborators">
                          <span>Collaborators:</span>
                          <div>
                            {(activity.teamCollaborators ?? []).filter(Boolean).map((slug) => (
                              <a href={`/people/${slug}`}>
                                {teamMemberNames.get(slug as string) ?? slug}
                              </a>
                            ))}
                            {(activity.otherCollaborators ?? []).filter(Boolean).map((name) => (
                              <span class="person-activity-external">{name}</span>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {professionalRoles.length > 0 && (
            <section class="person-profile-content person-structured-section" aria-labelledby="professional-roles-heading">
              <h2 id="professional-roles-heading">Professional roles and memberships</h2>
              <div class="person-record-list">
                {professionalRoles.map((entry) => {
                  const dates = [entry.startYear, entry.endYear]
                    .filter(Boolean)
                    .join("–");
                  return (
                    <article class="person-record">
                      <div>
                        <h3>{entry.title}</h3>
                        {(entry.organisation || dates) && (
                          <p class="person-record-meta">
                            {[entry.organisation, dates].filter(Boolean).join(" · ")}
                          </p>
                        )}
                      </div>
                      <span class="person-record-type">
                        {professionalRoleTypeLabels[entry.type] ?? "Other role"}
                      </span>
                    </article>
                  );
                })}
              </div>
            </section>
          )}

          {(teaching.length > 0 || supervision.length > 0) && (
            <section class="person-profile-content person-structured-section" aria-labelledby="teaching-supervision-heading">
              <h2 id="teaching-supervision-heading">Teaching and supervision</h2>
              {teaching.length > 0 && (
                <div class="person-profile-subsection">
                  <h3>Teaching</h3>
                  <div class="person-record-list">
                    {teaching.map((entry) => {
                      const years = [entry.fromYear, entry.toYear]
                        .filter(Boolean)
                        .map((year) => year === "present" ? "Present" : year)
                        .join("–");
                      return (
                        <article class="person-record">
                          <div>
                            <h4>{entry.course}</h4>
                            {entry.module && (
                              <p class="person-record-module">{entry.module}</p>
                            )}
                            <p class="person-record-meta">
                              {qualificationLabels[entry.level] ?? entry.level}
                              {years && <span> · {years}</span>}
                            </p>
                          </div>
                        </article>
                      );
                    })}
                  </div>
                </div>
              )}
              {supervision.length > 0 && (
                <div class="person-profile-subsection">
                  <h3>Supervision</h3>
                  <div class="person-record-list">
                    {supervision.map((entry) => (
                      <article class="person-record">
                        <div>
                          <h4>{entry.studentName}</h4>
                          <p class="person-record-meta">
                            {qualificationLabels[entry.qualification] ?? entry.qualification}
                            {(entry.fromYear || entry.toYear) && (
                              <span>
                                {" · "}
                                {[entry.fromYear, entry.toYear]
                                  .filter(Boolean)
                                  .map((year) => year === "present" ? "Present" : year)
                                  .join("–")}
                              </span>
                            )}
                          </p>
                        </div>
                        {entry.projectTitle && <p>{entry.projectTitle}</p>}
                      </article>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )}

          {methodsAndExpertise.length > 0 && (
            <section class="person-expertise" aria-labelledby="expertise-heading">
              <h2 id="expertise-heading">Skills</h2>
              <div class="person-expertise-tags">
                {methodsAndExpertise.map((item: string) => (
                  <span class="person-expertise-tag">
                    {item}
                  </span>
                ))}
              </div>
            </section>
          )}

          {hasRelatedWork && (
            <section class="person-related-work" aria-labelledby="related-work-heading">
              <h2 id="related-work-heading">Related work</h2>
              <p class="person-related-intro">
                Open a category and follow a link to the full study or output page.
              </p>
              <div class="person-related-dropdowns">
                {relatedWorkGroups.map((group, index) => (
                  <details class="person-related-dropdown" open={index === 0}>
                    <summary>
                      <span>{group.label}</span>
                      <span>{group.items.length}</span>
                    </summary>
                    <ul>
                      {group.items.map((item) => (
                        <li>
                          <a href={item.href}>
                            <span>
                              <strong>{item.title}</strong>
                              {item.summary && <small>{item.summary}</small>}
                            </span>
                            <span aria-hidden="true">→</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ))}
              </div>
            </section>
          )}

      <section class="person-publications" aria-labelledby="publications-heading">
      <h2 id="publications-heading">Publications</h2>
      {
        pubs.length === 0 ? (
          <p class="mt-3 text-muted">No publications found for this person yet.</p>
        ) : (
          <div class="mt-6">
            {years.map((year) => (
              <div class="mb-6">
                <p class="mb-2 text-xs tracking-wide text-cloud-400">{year || "Undated"}</p>
                {byYear.get(year)!.map((p) => (
                  <div class="flex items-start justify-between gap-4 border-t border-line py-3">
                    <div>
                      <p class="leading-6 text-ink">{p.title}</p>
                      <p class="text-sm text-muted">
                        {[p.venue].filter(Boolean).join(" · ")}
                        {p.citations > 0 && <span> · {p.citations} citations</span>}
                      </p>
                    </div>
                    {p.url && (
                      <a href={p.url} aria-label="Open publication">
                        <i class="ti ti-external-link text-lg text-muted" aria-hidden="true"></i>
                      </a>
                    )}
                  </div>
                ))}
              </div>
            ))}
          </div>
        )
      }
      </section>
        </div>
      </div>
    </div>
  </section>
</Layout>
