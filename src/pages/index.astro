---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import {
  teamPublications,
  type Pub,
} from "../lib/publications";

const reader = createReader(process.cwd(), keystaticConfig);

const home = await reader.singletons.home.read();
const team = await reader.collections.team.all();
const manualEntries =
  await reader.collections.publications.all();

const publicationIdentifiers = team
  .map((person) => person.entry.identifier)
  .filter(Boolean) as string[];

const manualPublications: Pub[] = manualEntries.map(
  (publication) => ({
    title: publication.entry.title,
    year: publication.entry.year ?? null,
    doi: null,
    venue: publication.entry.venue ?? "",
    citations: 0,
    authors: publication.entry.authors ?? "",
    url: publication.entry.url ?? null,
  })
);

const publications = await teamPublications(
  publicationIdentifiers,
  {
    hidden: (home?.hiddenDois ?? []) as string[],
    manual: manualPublications,
  }
);

const memberCount = team.length;
const publicationCount = publications.length;

const citationCount = publications.reduce(
  (total, publication) =>
    total + publication.citations,
  0
);

const formatNumber = (value: number) =>
  value.toLocaleString("en-GB");

const aboutHeading =
  home?.aboutHeading ||
  "Understanding and reducing health inequalities";

const aboutBody =
  home?.aboutBody ||
  "The Health Inequalities Team is based in the Population Health Sciences Institute at Newcastle University.";

const paragraphs = aboutBody
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

const highlightHeading =
  home?.highlightHeading ||
  "HIT Highlights";

const inequalitiesContent = home?.inequalitiesSection;

const inequalitiesEyebrow =
  inequalitiesContent?.eyebrow ||
  "Understanding the issue";

const inequalitiesHeading =
  inequalitiesContent?.heading ||
  "What are health inequalities?";

const inequalitiesDefinitionLabel =
  inequalitiesContent?.definitionLabel ||
  "A working definition";

const inequalitiesDefinition =
  inequalitiesContent?.definition ||
  "Health inequalities are systematic, unfair and avoidable differences in health between groups of people.";

const inequalitiesDefinitionSourceLabel =
  inequalitiesContent?.definitionSourceLabel ||
  "Read the source";

const inequalitiesDefinitionSourceUrl =
  inequalitiesContent?.definitionSourceUrl;

const inequalitiesSubsections =
  inequalitiesContent?.subsections ?? [];

const splitParagraphs = (value: string) =>
  value
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

export const prerender = true;
---

<Layout>
  <Hero
    heading={home?.heading || "Health Inequalities Team"}
    intro={home?.intro || "The Health Inequalities Team is based in the Population Health Sciences Institute at Newcastle University."}
  />

  <section class="section">
    <div class="container-page grid items-start gap-10 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-14">
   <aside
  id="highlights"
  class="highlight-box"
  aria-labelledby="highlight-heading"
>
  <h2
    id="highlight-heading"
    class="text-2xl text-navy-900"
  >
    {highlightHeading}
  </h2>

  <div class="highlight-stats">
    <div class="highlight-stat">
      <strong data-count-up={memberCount}>
        {formatNumber(memberCount)}
      </strong>

      <span>
        team members
      </span>
    </div>

    <div class="highlight-stat">
      <strong data-count-up={publicationCount}>
        {formatNumber(publicationCount)}
      </strong>

      <span>
        publications
      </span>
    </div>

    <div class="highlight-stat">
      <strong data-count-up={citationCount}>
        {formatNumber(citationCount)}
      </strong>

      <span>
        citations
      </span>
    </div>
  </div>
</aside>

      <div id="about-hit" class="max-w-3xl">
        <p class="eyebrow">
          About HIT
        </p>

        <h2 class="mt-3">
          {aboutHeading}
        </h2>

        <div class="mt-6 space-y-4 leading-7 text-ink">
          {
            paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/people"
            class="btn-primary"
          >
            Meet the team
          </a>

          <a
            href="/research"
            class="btn-secondary"
          >
            Our research
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    id="what-are-health-inequalities"
    class="inequalities-section"
    aria-labelledby="inequalities-heading"
  >
    <div class="container-page">
      <div class="inequalities-intro">
        <div>
          <p class="eyebrow">{inequalitiesEyebrow}</p>

          <h2 id="inequalities-heading" class="mt-3">
            {inequalitiesHeading}
          </h2>
        </div>

        <div class="inequalities-definition">
          <p class="inequalities-definition-label">
            {inequalitiesDefinitionLabel}
          </p>

          <div class="inequalities-definition-copy">
            {
              splitParagraphs(inequalitiesDefinition).map((paragraph) => (
                <p>{paragraph}</p>
              ))
            }
          </div>

          {inequalitiesDefinitionSourceUrl && (
            <a
              href={inequalitiesDefinitionSourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {inequalitiesDefinitionSourceLabel}
              <i class="ti ti-external-link" aria-hidden="true"></i>
            </a>
          )}
        </div>
      </div>

      {inequalitiesSubsections.length > 0 && (
        <div class="inequalities-theories">
          {inequalitiesSubsections.map((subsection, index) => (
            <article class="inequalities-theory-card">
              <p class="inequalities-theory-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </p>

              <h3>{subsection.heading}</h3>

              <div class="inequalities-theory-copy">
                {splitParagraphs(subsection.body).map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>

              {subsection.sourceUrl && (
                <a
                  href={subsection.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {subsection.sourceLabel || "Read the source"}
                  <i class="ti ti-external-link" aria-hidden="true"></i>
                </a>
              )}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

<script>
  const counters =
    document.querySelectorAll<HTMLElement>("[data-count-up]");

  const prefersReducedMotion =
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const numberFormatter = new Intl.NumberFormat("en-GB");

  const animateCounter = (counter: HTMLElement) => {
    const target = Number(counter.dataset.countUp ?? 0);

    if (prefersReducedMotion || target <= 0) {
      counter.textContent = numberFormatter.format(target);
      return;
    }

    const duration = 3000;
    const startTime = performance.now();

    counter.textContent = "0";

    const updateCounter = (currentTime: number) => {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);

      /*
       * Ease-out animation:
       * fast at the beginning and slower near the final number.
       */
      const easedProgress = 1 - Math.pow(1 - progress, 3);
      const currentValue = Math.round(target * easedProgress);

      counter.textContent =
        numberFormatter.format(currentValue);

      if (progress < 1) {
        requestAnimationFrame(updateCounter);
      } else {
        counter.textContent =
          numberFormatter.format(target);
      }
    };

    requestAnimationFrame(updateCounter);
  };

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const counter = entry.target as HTMLElement;

          animateCounter(counter);
          observer.unobserve(counter);
        });
      },
      {
        threshold: 0.4,
      }
    );

    counters.forEach((counter) => {
      if (!prefersReducedMotion) {
        counter.textContent = "0";
      }

      observer.observe(counter);
    });
  } else {
    counters.forEach(animateCounter);
  }
</script>

</Layout>
