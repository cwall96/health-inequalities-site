---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.home.read();

const aboutHeading =
  home?.aboutHeading ||
  "Understanding and reducing health inequalities";

const aboutBody =
  home?.aboutBody ||
  "The Health Inequalities Team is based in the Population Health Sciences Institute at Newcastle University.";

const paragraphs = aboutBody
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

const highlightHeading =
  home?.highlightHeading ||
  "Highlights";

const highlightBody =
  home?.highlightBody ||
  "This is where the team highlight can go";

const highlightParagraphs = highlightBody
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

export const prerender = true;
---

<Layout>
  <Hero />

  <section class="section">
    <div class="container-page grid items-start gap-10 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-14">
      <aside
        class="highlight-box"
        aria-labelledby="highlight-heading"
      >
        <p class="highlight-label">Team highlight</p>

        <h2 id="highlight-heading" class="mt-3 text-2xl text-navy-900">
  {highlightHeading}
</h2>

        <div class="mt-5 space-y-4 leading-7 text-navy-900">
          {
            highlightParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
        </div>
      </aside>

      <div class="max-w-3xl">
        <p class="eyebrow">About HIT</p>

        <h2 class="mt-3">
          {aboutHeading}
        </h2>

        <div class="mt-6 space-y-4 leading-7 text-ink">
          {
            paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/people" class="btn-primary">
            Meet the team
          </a>

          <a href="/research" class="btn-secondary">
            Our research
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>