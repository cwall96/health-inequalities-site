---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import {
  teamPublications,
  type Pub,
} from "../lib/publications";

const reader = createReader(process.cwd(), keystaticConfig);

const home = await reader.singletons.home.read();
const team = await reader.collections.team.all();
const researchThemes = home?.homepageResearchThemes ?? [];
const teamBySlug = new Map(team.map(({ slug, entry }) => [slug, entry.name]));
const manualEntries =
  await reader.collections.publications.all();
const latestNews = (await reader.collections.news.all())
  .sort((a, b) =>
    (b.entry.publishedDate ?? "").localeCompare(
      a.entry.publishedDate ?? ""
    )
  )
  .slice(0, 3);

const publicationIdentifiers = team
  .map((person) => person.entry.identifier)
  .filter(Boolean) as string[];

const manualPublications: Pub[] = manualEntries.map(
  (publication) => ({
    title: publication.entry.title,
    year: publication.entry.year ?? null,
    doi: null,
    venue: publication.entry.venue ?? "",
    citations: 0,
    authors: publication.entry.authors ?? "",
    url: publication.entry.url ?? null,
  })
);

const publications = await teamPublications(
  publicationIdentifiers,
  {
    hidden: (home?.hiddenDois ?? []) as string[],
    manual: manualPublications,
  }
);

const memberCount = team.length;
const publicationCount = publications.length;

const liveCitationCount = publications.reduce(
  (total, publication) =>
    total + publication.citations,
  0
);

const citationCount =
  liveCitationCount > 0
    ? liveCitationCount
    : (home?.citationFallback ?? 0);

const formatNumber = (value: number) =>
  value.toLocaleString("en-GB");

const formatDate = (value: Date) =>
  new Intl.DateTimeFormat(
  "en-GB",
  {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "Europe/London",
  }
).format(value);

const fallbackMetricsDate = home?.metricsUpdatedDate
  ? new Date(`${home.metricsUpdatedDate}T12:00:00Z`)
  : new Date();

const highlightsUpdatedDate = formatDate(
  liveCitationCount > 0
    ? new Date()
    : fallbackMetricsDate
);

const formatNewsDate = (value: string | null) =>
  value
    ? formatDate(new Date(`${value}T12:00:00Z`))
    : "";

const aboutHeading =
  home?.aboutHeading ||
  "Understanding and reducing health inequalities";

const aboutBody =
  home?.aboutBody ||
  "The Health Inequalities Team is based in the Population Health Sciences Institute at Newcastle University.";

const paragraphs = aboutBody
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

const highlightHeading =
  home?.highlightHeading ||
  "HIT Highlights";

const inequalitiesContent = home?.inequalitiesSection;

const inequalitiesEyebrow =
  inequalitiesContent?.eyebrow ||
  "Understanding the issue";

const inequalitiesHeading =
  inequalitiesContent?.heading ||
  "What are health inequalities?";

const inequalitiesDefinitionLabel =
  inequalitiesContent?.definitionLabel ||
  "A working definition";

const inequalitiesDefinition =
  inequalitiesContent?.definition ||
  "Health inequalities are systematic, unfair and avoidable differences in health between groups of people.";

const inequalitiesDefinitionSourceLabel =
  inequalitiesContent?.definitionSourceLabel ||
  "Read the source";

const inequalitiesDefinitionSourceUrl =
  inequalitiesContent?.definitionSourceUrl;

const inequalitiesSubsections =
  inequalitiesContent?.subsections ?? [];

const splitParagraphs = (value: string) =>
  value
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

const homeDecorations = Array.from(
  { length: 30 },
  (_, index) => ({
    type: index % 2 === 0 ? "not-equal" : "target",
    left: 2 + ((index * 37) % 95),
    duration: 48 + ((index * 7) % 29),
    delay: -((index * 13) % 71),
  })
);

export const prerender = true;
---

<Layout>
  <div class="home-page-shell">
    <div class="home-floating-marks" aria-hidden="true">
      {
        homeDecorations.map((decoration) => (
          <span
            class:list={[
              "home-floating-mark",
              decoration.type === "target"
                ? "home-floating-target"
                : "home-floating-not-equal",
            ]}
            style={`--mark-left: ${decoration.left}%; --mark-duration: ${decoration.duration}s; --mark-delay: ${decoration.delay}s;`}
          >
            {decoration.type === "target" ? (
              <><i></i><b></b></>
            ) : (
              "≠"
            )}
          </span>
        ))
      }
    </div>

  <Hero
    heading={home?.heading || "Health Inequalities Team"}
    intro={home?.intro || "The Health Inequalities Team is based in the Population Health Sciences Institute at Newcastle University."}
  />

  <section class="section">
    <div class="container-page home-about-layout">
<aside
  id="highlights"
  class="highlight-box"
  aria-labelledby="highlight-heading"
  data-reveal
>
  <div class="highlight-heading">
    <span class="highlight-heading-icon" aria-hidden="true">
      <i class="ti ti-sparkles"></i>
    </span>

    <div>
      <p class="highlight-kicker">Team snapshot</p>
      <h2 id="highlight-heading">
        {highlightHeading}
      </h2>
    </div>
  </div>

  <div class="highlight-stats">
    <div class="highlight-stat">
      <span class="highlight-stat-icon" aria-hidden="true">
        <i class="ti ti-users"></i>
      </span>
      <span class="highlight-stat-copy">
        <strong data-count-up={memberCount}>
          {formatNumber(memberCount)}
        </strong>
        <span>team members</span>
      </span>
    </div>

    <div class="highlight-stat">
      <span class="highlight-stat-icon" aria-hidden="true">
        <i class="ti ti-books"></i>
      </span>
      <span class="highlight-stat-copy">
        <strong data-count-up={publicationCount}>
          {formatNumber(publicationCount)}
        </strong>
        <span>publications</span>
      </span>
    </div>

    <div class="highlight-stat">
      <span class="highlight-stat-icon" aria-hidden="true">
        <i class="ti ti-quote"></i>
      </span>
      <span class="highlight-stat-copy">
        <strong data-count-up={citationCount}>
          {formatNumber(citationCount)}
        </strong>
        <span>citations</span>
      </span>
    </div>
  </div>

  <p class="highlight-updated">
    (Approx., updated {highlightsUpdatedDate})
  </p>

  {latestNews.length > 0 && (
    <div class="highlight-news">
      <h3>
        <i class="ti ti-bolt" aria-hidden="true"></i>
        What's New?
      </h3>

      <ul>
        {latestNews.map((post) => (
          <li>
            <a href={`/news/${post.slug}`}>
              <span class="highlight-news-copy">
                <span>{post.entry.title}</span>
                {post.entry.publishedDate && (
                  <time datetime={post.entry.publishedDate}>
                    {formatNewsDate(post.entry.publishedDate)}
                  </time>
                )}
              </span>
              <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ul>

      <a href="/news" class="highlight-news-all">
        View all updates
        <span aria-hidden="true">→</span>
      </a>
    </div>
  )}
</aside>

      <div id="about-hit" class="max-w-3xl" data-reveal>
        <p class="eyebrow">
          About HIT
        </p>

        <h2 class="mt-3">
          {aboutHeading}
        </h2>

        <div class="mt-6 space-y-4 leading-7 text-ink [&_a]:underline">
          {
            paragraphs.map((paragraph) => (
              <p>
                {paragraph.split(/\[([^\]\n]+)\]\((https?:\/\/[^\s()]+)\)/g).map(
                  (part, index, parts) => {
                    if (index % 3 === 1) {
                      return <a href={parts[index + 1]}>{part}</a>;
                    }
                    if (index % 3 === 0) return part;
                  },
                )}
              </p>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/people"
            class="btn-primary"
          >
            Meet the team
          </a>
        </div>

      </div>

    </div>
  </section>

  {researchThemes.length > 0 && (
    <section class="section bg-navy-900" aria-labelledby="research-themes-heading">
      <div class="container-page">
        <h2 id="research-themes-heading" class="text-white">Our research themes</h2>
        <ul class="mt-8 grid gap-6 md:grid-cols-2">
          {researchThemes.map(({ title, description, lead, leadProfile, teamMembers }, index) => {
            const members = [...new Set(teamMembers)].flatMap((slug) => {
              const name = slug && teamBySlug.get(slug);
              return slug && name && slug !== leadProfile ? [{ slug, name }] : [];
            });

            return (
              <li class="rounded-xl border border-line border-t-4 border-t-red-700 bg-white p-6 shadow-card sm:p-8">
                <span aria-hidden="true" class="inline-flex size-11 items-center justify-center rounded-full bg-red-700 font-semibold text-white">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-4">{title}</h3>
                <p class="mt-3 leading-7 text-ink">{description}</p>
                {lead && (
                  <p class="mt-5 border-t border-line pt-4 text-sm">
                    <strong>Lead</strong>{" · "}
                    {leadProfile && teamBySlug.has(leadProfile) ? (
                      <a class="text-navy-800 underline" href={`/people/${leadProfile}`}>{lead}</a>
                    ) : lead}
                  </p>
                )}
                {members.length > 0 && (
                  <div class="mt-4">
                    <p class="text-sm font-semibold">HIT team members</p>
                    <ul class="mt-2 flex flex-wrap gap-2">
                      {members.map(({ slug, name }) => (
                        <li><a class="chip underline" href={`/people/${slug}`}>{name}</a></li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section
    id="what-are-health-inequalities"
    class="inequalities-section"
    aria-labelledby="inequalities-heading"
  >
    <div class="container-page">
      <div class="inequalities-intro" data-reveal>
        <div>
          <p class="eyebrow">{inequalitiesEyebrow}</p>

          <h2 id="inequalities-heading" class="mt-3">
            {inequalitiesHeading}
          </h2>
        </div>

        <div class="inequalities-definition">
          <p class="inequalities-definition-label">
            {inequalitiesDefinitionLabel}
          </p>

          <div class="inequalities-definition-copy">
            {
              splitParagraphs(inequalitiesDefinition).map((paragraph) => (
                <p>
                {paragraph.split(/\[([^\]\n]+)\]\((https?:\/\/[^\s()]+)\)/g).map(
                  (part, index, parts) => {
                    if (index % 3 === 1) {
                      return <a href={parts[index + 1]}>{part}</a>;
                    }
                    if (index % 3 === 0) return part;
                  },
                )}
              </p>
              ))
            }
          </div>

          {inequalitiesDefinitionSourceUrl && (
            <a
              href={inequalitiesDefinitionSourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {inequalitiesDefinitionSourceLabel}
              <i class="ti ti-external-link" aria-hidden="true"></i>
            </a>
          )}
        </div>
      </div>

      {inequalitiesSubsections.length > 0 && (
        <div class="inequalities-theories">
          {inequalitiesSubsections.map((subsection) => (
            <article class="inequalities-theory-card" data-reveal>
              <h3>{subsection.heading}</h3>

              <div class="inequalities-theory-copy">
                {splitParagraphs(subsection.body).map((paragraph) => (
                  <p>
                {paragraph.split(/\[([^\]\n]+)\]\((https?:\/\/[^\s()]+)\)/g).map(
                  (part, index, parts) => {
                    if (index % 3 === 1) {
                      return <a href={parts[index + 1]}>{part}</a>;
                    }
                    if (index % 3 === 0) return part;
                  },
                )}
              </p>
                ))}
              </div>

              {subsection.sourceUrl && (
                <a
                  href={subsection.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {subsection.sourceLabel || "Read the source"}
                  <i class="ti ti-external-link" aria-hidden="true"></i>
                </a>
              )}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

<script>
  const counters =
    document.querySelectorAll<HTMLElement>("[data-count-up]");

  const prefersReducedMotion =
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const numberFormatter = new Intl.NumberFormat("en-GB");

  const animateCounter = (counter: HTMLElement) => {
    const target = Number(counter.dataset.countUp ?? 0);

    if (prefersReducedMotion || target <= 0) {
      counter.textContent = numberFormatter.format(target);
      return;
    }

    const duration = 3000;
    const startTime = performance.now();

    counter.textContent = "0";

    const updateCounter = (currentTime: number) => {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);

      /*
       * Ease-out animation:
       * fast at the beginning and slower near the final number.
       */
      const easedProgress = 1 - Math.pow(1 - progress, 3);
      const currentValue = Math.round(target * easedProgress);

      counter.textContent =
        numberFormatter.format(currentValue);

      if (progress < 1) {
        requestAnimationFrame(updateCounter);
      } else {
        counter.textContent =
          numberFormatter.format(target);
      }
    };

    requestAnimationFrame(updateCounter);
  };

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const counter = entry.target as HTMLElement;

          animateCounter(counter);
          observer.unobserve(counter);
        });
      },
      {
        threshold: 0.4,
      }
    );

    counters.forEach((counter) => {
      if (!prefersReducedMotion) {
        counter.textContent = "0";
      }

      observer.observe(counter);
    });
  } else {
    counters.forEach(animateCounter);
  }

</script>

  </div>

</Layout>
