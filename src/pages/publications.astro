---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import { normDoi, teamPublications, type Pub } from "../lib/publications";

const reader = createReader(process.cwd(), keystaticConfig);
const team = await reader.collections.team.all();
const settings = await reader.singletons.home.read();
const manualEntries = await reader.collections.publications.all();
const publicationTagEntries = await reader.collections.publicationTags.all();
const themeEntries = (await reader.collections.researchThemes.all()).sort(
  (a, b) =>
    (a.entry.order ?? 0) - (b.entry.order ?? 0) ||
    a.entry.name.localeCompare(b.entry.name)
);

const publicationSources = team
  .filter((person) => person.entry.identifier)
  .map((person) => ({
    identifier: person.entry.identifier as string,
    teamMember: person.slug,
  }));

const teamBySlug = new Map(team.map((person) => [person.slug, person.entry.name]));
const themeBySlug = new Map(themeEntries.map((theme) => [theme.slug, theme.entry.name]));
const teamOptions = [...team]
  .sort((a, b) => a.entry.name.localeCompare(b.entry.name))
  .map((person) => ({ slug: person.slug, name: person.entry.name }));

const manual: Pub[] = manualEntries.map((m) => ({
  title: m.entry.title,
  year: m.entry.year ?? null,
  doi: null,
  venue: m.entry.venue ?? "",
  citations: 0,
  authors: m.entry.authors ?? "",
  abstract: m.entry.abstract?.trim() || null,
  url: m.entry.url ?? null,
  teamMembers: (m.entry.teamMembers ?? []).filter(Boolean) as string[],
  researchThemes: (m.entry.researchThemes ?? []).filter(Boolean) as string[],
}));

const importedPubs = await teamPublications(publicationSources, {
  hidden: (settings?.hiddenDois ?? []) as string[],
  manual,
});

const tagsByDoi = new Map(
  publicationTagEntries.flatMap((entry) => {
    const doi = normDoi(entry.entry.doi);
    return doi ? [[doi, entry.entry] as const] : [];
  })
);

const normaliseSearchText = (value: string) =>
  value
    .normalize("NFKD")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, " ")
    .trim();

const pubs = importedPubs.map((publication) => {
  const tags = publication.doi ? tagsByDoi.get(publication.doi) : undefined;
  const searchableText = normaliseSearchText(
    [publication.title, ...(publication.searchTerms ?? [])].join(" ")
  );
  const automaticThemes = themeEntries
    .filter((theme) => {
      const matchingTerms = [
        theme.entry.name,
        ...(theme.entry.publicationKeywords ?? []),
      ];
      return matchingTerms.some((term) => {
        const normalisedTerm = normaliseSearchText(term);
        return normalisedTerm && searchableText.includes(normalisedTerm);
      });
    })
    .map((theme) => theme.slug);

  return {
    ...publication,
    teamMembers: [
      ...new Set([
        ...(publication.teamMembers ?? []),
        ...((tags?.teamMembers ?? []).filter(Boolean) as string[]),
      ]),
    ],
    researchThemes: [
      ...new Set([
        ...(publication.researchThemes ?? []),
        ...automaticThemes,
        ...((tags?.researchThemes ?? []).filter(Boolean) as string[]),
      ]),
    ],
  };
});

const selectedSpotlightDoi = normDoi(settings?.featuredDoi);
const selectedSpotlight = selectedSpotlightDoi
  ? pubs.find((publication) => publication.doi === selectedSpotlightDoi)
  : null;
const spotlightPublication =
  selectedSpotlight ??
  [...pubs].sort(
    (a, b) =>
      b.citations - a.citations ||
      (b.year ?? 0) - (a.year ?? 0)
  )[0] ??
  null;
const spotlightSummary =
  settings?.featuredPublicationSummary?.trim() ||
  "Selected from the Health Inequalities Team’s published research.";
const spotlightAbstract =
  settings?.featuredPublicationAbstract?.trim() ||
  spotlightPublication?.abstract?.trim() ||
  "";

const byYear = new Map<number, Pub[]>();
for (const p of pubs) {
  const y = p.year ?? 0;
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const journals = [...new Set(pubs.map((p) => p.venue.trim()).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b));

const publicationPageSize = 40;
const publicationPageCount = Math.ceil(pubs.length / publicationPageSize);
const firstPublicationPage = new Set(pubs.slice(0, publicationPageSize));
const publicationPageGroupStart = (page: number) =>
  page <= 5 ? 1 : 6 + Math.floor((page - 6) / 6) * 6;
const publicationPageGroups: Array<{ start: number; end: number }> = [];
if (publicationPageCount > 0) {
  publicationPageGroups.push({ start: 1, end: Math.min(5, publicationPageCount) });
  for (let start = 6; start <= publicationPageCount; start += 6) {
    publicationPageGroups.push({ start, end: Math.min(start + 5, publicationPageCount) });
  }
}

export const prerender = true;
---

<Layout title="Publications — Health Inequalities Team">
  <section class="section page-intro-section">
    <div class="container-page">
      <div class="page-intro max-w-2xl">
        <p class="eyebrow">Research outputs</p>
        <h1 class="mt-3">Publications</h1>
      </div>

      {spotlightPublication && (
        <article class="publication-spotlight" aria-labelledby="publication-spotlight-title">
          <div class="publication-spotlight-main">
            <p class="publication-spotlight-label">
              <span aria-hidden="true">✦</span>
              Publication spotlight
            </p>
            <h2 id="publication-spotlight-title">{spotlightPublication.title}</h2>
            <p class="publication-spotlight-summary">{spotlightSummary}</p>
            {((spotlightPublication.teamMembers?.length ?? 0) > 0 ||
              (spotlightPublication.researchThemes?.length ?? 0) > 0) && (
              <div class="publication-spotlight-tags">
                {(spotlightPublication.teamMembers ?? []).map((slug) => {
                  const name = teamBySlug.get(slug);
                  return name ? <a href={`/people/${slug}`}>{name}</a> : null;
                })}
                {(spotlightPublication.researchThemes ?? []).map((slug) => {
                  const name = themeBySlug.get(slug);
                  return name ? <span>{name}</span> : null;
                })}
              </div>
            )}
            {spotlightPublication.url && (
              <a
                href={spotlightPublication.url}
                class="publication-spotlight-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                Read the publication
                <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            )}
          </div>

          <aside class="publication-spotlight-details" aria-label="Publication details">
            <div class="publication-spotlight-mark" aria-hidden="true">
              <span></span>
              <i></i>
            </div>
            <p class="publication-spotlight-details-label">At a glance</p>
            {spotlightPublication.citations > 0 && (
              <div class="publication-spotlight-citations">
                <strong>{spotlightPublication.citations.toLocaleString("en-GB")}</strong>
                <span>citations recorded by OpenAlex</span>
              </div>
            )}
            <dl>
              {spotlightPublication.year && (
                <div>
                  <dt>Published</dt>
                  <dd>{spotlightPublication.year}</dd>
                </div>
              )}
              {spotlightPublication.venue && (
                <div>
                  <dt>Journal</dt>
                  <dd>{spotlightPublication.venue}</dd>
                </div>
              )}
              {spotlightPublication.doi && (
                <div>
                  <dt>DOI</dt>
                  <dd>{spotlightPublication.doi}</dd>
                </div>
              )}
            </dl>
          </aside>

          {spotlightAbstract && (
            <div class="publication-spotlight-abstract">
              <h3>Abstract</h3>
              <p>{spotlightAbstract}</p>
            </div>
          )}
        </article>
      )}

      {
        pubs.length === 0 ? (
          <p class="mt-10 text-muted">
            No publications found yet. Add an ORCID (or OpenAlex ID) to each person in
            <code>/keystatic</code>, then rebuild.
          </p>
        ) : (
          <div class="mt-10" data-publication-filters>
            <form class="publication-filters" aria-label="Filter publications" onsubmit="return false">
              <div>
                <label for="publication-year">Publication year</label>
                <select id="publication-year" data-filter="year">
                  <option value="">All years</option>
                  {years.map((year) => <option value={String(year)}>{year || "Undated"}</option>)}
                </select>
              </div>

              <div>
                <label for="team-member">HIT team member</label>
                <select id="team-member" data-filter="person">
                  <option value="">All team members</option>
                  {teamOptions.map((person) => <option value={person.slug}>{person.name}</option>)}
                </select>
              </div>

              <div>
                <label for="publication-theme">Research theme</label>
                <select id="publication-theme" data-filter="theme">
                  <option value="">All themes</option>
                  {themeEntries.map((theme) => <option value={theme.slug}>{theme.entry.name}</option>)}
                </select>
              </div>

              <div>
                <label for="publication-journal">Journal</label>
                <select id="publication-journal" data-filter="journal">
                  <option value="">All journals</option>
                  {journals.map((journal) => <option value={journal}>{journal}</option>)}
                </select>
              </div>

              <button type="button" class="filter-reset" data-filter-reset>Clear filters</button>
            </form>

            <p class="mt-5 text-sm text-muted" aria-live="polite" data-publication-count>
              Showing 1–{Math.min(publicationPageSize, pubs.length)} of {pubs.length} publications
            </p>

            <nav
              class="publication-pagination publication-pagination-top"
              aria-label="Publication pages above results"
              data-publication-pagination
              hidden={publicationPageCount <= 1}
            >
              <button type="button" class="publication-page-direction" data-page-previous disabled>
                <span aria-hidden="true">←</span> Previous
              </button>
              <div class="publication-page-numbers">
                {Array.from({ length: publicationPageCount }, (_, index) => index + 1).map((page) => (
                  <button
                    type="button"
                    class:list={["publication-page-number", { "is-active": page === 1 }]}
                    data-page-number={String(page)}
                    data-page-group-start={String(publicationPageGroupStart(page))}
                    style={`order: ${page}`}
                    hidden={publicationPageGroupStart(page) !== 1}
                    aria-current={page === 1 ? "page" : undefined}
                    aria-label={`Page ${page}`}
                  >
                    {page}
                  </button>
                ))}
                {publicationPageGroups.map((group) => (
                  <button
                    type="button"
                    class="publication-page-range"
                    data-page-group={String(group.start)}
                    data-page-group-end={String(group.end)}
                    style={`order: ${group.start}`}
                    hidden={group.start === 1}
                    aria-label={`Show pages ${group.start} to ${group.end}`}
                  >
                    {group.start}–{group.end}
                  </button>
                ))}
              </div>
              <button type="button" class="publication-page-direction" data-page-next>
                Next <span aria-hidden="true">→</span>
              </button>
            </nav>

            <div class="publication-list mt-8 max-w-4xl">
            {years.map((year) => (
              <div
                class="mb-8"
                data-year-group
                hidden={!byYear.get(year)!.some((publication) => firstPublicationPage.has(publication))}
              >
                <p class="mb-2 text-xs tracking-wide text-cloud-400">{year || "Undated"}</p>
                {byYear.get(year)!.map((p) => (
                  <article
                    class="flex items-start justify-between gap-4 border-t border-line py-4"
                    data-publication
                    hidden={!firstPublicationPage.has(p)}
                    data-year={String(p.year ?? 0)}
                    data-team-members={JSON.stringify(p.teamMembers ?? [])}
                    data-themes={JSON.stringify(p.researchThemes ?? [])}
                    data-journal={p.venue.trim().toLowerCase()}
                  >
                    <div>
                      <p class="leading-6 text-ink">{p.title}</p>
                      <p class="text-sm text-muted">
                        {[p.authors, p.venue].filter(Boolean).join(" · ")}
                        {p.citations > 0 && <span> · {p.citations} citations</span>}
                      </p>
                      {((p.teamMembers?.length ?? 0) > 0 || (p.researchThemes?.length ?? 0) > 0) && (
                        <div class="publication-tags">
                          {(p.teamMembers ?? []).map((slug) => {
                            const name = teamBySlug.get(slug);
                            return name ? <a href={`/people/${slug}`}>{name}</a> : null;
                          })}
                          {(p.researchThemes ?? []).map((slug) => {
                            const name = themeBySlug.get(slug);
                            return name ? <span>{name}</span> : null;
                          })}
                        </div>
                      )}
                    </div>
                    {p.url && (
                      <a href={p.url} aria-label="Open publication">
                        <i class="ti ti-external-link text-lg text-muted" aria-hidden="true"></i>
                      </a>
                    )}
                  </article>
                ))}
              </div>
            ))}
            </div>

            <nav
              class="publication-pagination publication-pagination-bottom"
              aria-label="Publication pages below results"
              data-publication-pagination
              hidden={publicationPageCount <= 1}
            >
              <button type="button" class="publication-page-direction" data-page-previous disabled>
                <span aria-hidden="true">←</span> Previous
              </button>
              <div class="publication-page-numbers">
                {Array.from({ length: publicationPageCount }, (_, index) => index + 1).map((page) => (
                  <button
                    type="button"
                    class:list={["publication-page-number", { "is-active": page === 1 }]}
                    data-page-number={String(page)}
                    data-page-group-start={String(publicationPageGroupStart(page))}
                    style={`order: ${page}`}
                    hidden={publicationPageGroupStart(page) !== 1}
                    aria-current={page === 1 ? "page" : undefined}
                    aria-label={`Page ${page}`}
                  >
                    {page}
                  </button>
                ))}
                {publicationPageGroups.map((group) => (
                  <button
                    type="button"
                    class="publication-page-range"
                    data-page-group={String(group.start)}
                    data-page-group-end={String(group.end)}
                    style={`order: ${group.start}`}
                    hidden={group.start === 1}
                    aria-label={`Show pages ${group.start} to ${group.end}`}
                  >
                    {group.start}–{group.end}
                  </button>
                ))}
              </div>
              <button type="button" class="publication-page-direction" data-page-next>
                Next <span aria-hidden="true">→</span>
              </button>
            </nav>

            <p class="filter-empty" data-filter-empty hidden>
              No publications match those filters. Try clearing one or more selections.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <script>
    const filterPanel = document.querySelector<HTMLElement>("[data-publication-filters]");

    if (filterPanel) {
      const controls = [...filterPanel.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-filter]")];
      const publications = [...filterPanel.querySelectorAll<HTMLElement>("[data-publication]")];
      const yearGroups = [...filterPanel.querySelectorAll<HTMLElement>("[data-year-group]")];
      const count = filterPanel.querySelector<HTMLElement>("[data-publication-count]");
      const empty = filterPanel.querySelector<HTMLElement>("[data-filter-empty]");
      const reset = filterPanel.querySelector<HTMLButtonElement>("[data-filter-reset]");
      const paginations = [...filterPanel.querySelectorAll<HTMLElement>("[data-publication-pagination]")];
      const pageButtons = [...filterPanel.querySelectorAll<HTMLButtonElement>("[data-page-number]")];
      const pageRangeButtons = [...filterPanel.querySelectorAll<HTMLButtonElement>("[data-page-group]")];
      const previousButtons = [...filterPanel.querySelectorAll<HTMLButtonElement>("[data-page-previous]")];
      const nextButtons = [...filterPanel.querySelectorAll<HTMLButtonElement>("[data-page-next]")];
      const publicationList = filterPanel.querySelector<HTMLElement>(".publication-list");
      const pageSize = 40;
      let currentPage = 1;
      let expandedGroupStart = 1;

      const groupStartForPage = (page: number) =>
        page <= 5 ? 1 : 6 + Math.floor((page - 6) / 6) * 6;

      const applyFilters = (resetPage = false, moveFocus = false) => {
        if (resetPage) {
          currentPage = 1;
          expandedGroupStart = 1;
        }
        const year = filterPanel.querySelector<HTMLSelectElement>("[data-filter='year']")?.value ?? "";
        const person = filterPanel.querySelector<HTMLSelectElement>("[data-filter='person']")?.value ?? "";
        const theme = filterPanel.querySelector<HTMLSelectElement>("[data-filter='theme']")?.value ?? "";
        const journal = filterPanel.querySelector<HTMLInputElement>("[data-filter='journal']")?.value.trim().toLowerCase() ?? "";
        const matches = publications.filter((publication) => {
          const teamMembers = JSON.parse(publication.dataset.teamMembers ?? "[]") as string[];
          const themes = JSON.parse(publication.dataset.themes ?? "[]") as string[];
          return (
            (!year || publication.dataset.year === year) &&
            (!person || teamMembers.includes(person)) &&
            (!theme || themes.includes(theme)) &&
            (!journal || publication.dataset.journal?.includes(journal))
          );
        });

        const pageCount = Math.max(1, Math.ceil(matches.length / pageSize));
        currentPage = Math.min(currentPage, pageCount);
        if (expandedGroupStart > pageCount) {
          expandedGroupStart = groupStartForPage(currentPage);
        }
        const firstIndex = (currentPage - 1) * pageSize;
        const visiblePublications = new Set(matches.slice(firstIndex, firstIndex + pageSize));
        publications.forEach((publication) => {
          publication.hidden = !visiblePublications.has(publication);
        });

        yearGroups.forEach((group) => {
          group.hidden = !group.querySelector("[data-publication]:not([hidden])");
        });

        if (count) {
          const firstShown = matches.length === 0 ? 0 : firstIndex + 1;
          const lastShown = Math.min(firstIndex + pageSize, matches.length);
          count.textContent = matches.length === 0
            ? "Showing 0 publications"
            : `Showing ${firstShown}–${lastShown} of ${matches.length} publications`;
        }
        if (empty) empty.hidden = matches.length !== 0;
        paginations.forEach((pagination) => {
          pagination.hidden = matches.length <= pageSize;
        });
        previousButtons.forEach((button) => {
          button.disabled = currentPage === 1;
        });
        nextButtons.forEach((button) => {
          button.disabled = currentPage === pageCount;
        });

        pageButtons.forEach((button) => {
          const page = Number(button.dataset.pageNumber);
          const isActive = page === currentPage;
          const groupStart = Number(button.dataset.pageGroupStart);
          button.hidden = page > pageCount || groupStart !== expandedGroupStart;
          button.classList.toggle("is-active", isActive);
          if (isActive) button.setAttribute("aria-current", "page");
          else button.removeAttribute("aria-current");
        });

        pageRangeButtons.forEach((button) => {
          const groupStart = Number(button.dataset.pageGroup);
          const originalEnd = Number(button.dataset.pageGroupEnd);
          const groupEnd = Math.min(originalEnd, pageCount);
          button.hidden = groupStart > pageCount || groupStart === expandedGroupStart;
          button.textContent = groupStart === groupEnd
            ? String(groupStart)
            : `${groupStart}–${groupEnd}`;
          button.setAttribute("aria-label", `Show pages ${groupStart} to ${groupEnd}`);
        });

        if (moveFocus) publicationList?.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      controls.forEach((control) => control.addEventListener("input", () => applyFilters(true)));
      reset?.addEventListener("click", () => {
        controls.forEach((control) => (control.value = ""));
        applyFilters(true);
        controls[0]?.focus();
      });

      pageButtons.forEach((button) => button.addEventListener("click", () => {
        currentPage = Number(button.dataset.pageNumber);
        expandedGroupStart = groupStartForPage(currentPage);
        applyFilters(false, true);
      }));
      pageRangeButtons.forEach((button) => button.addEventListener("click", () => {
        expandedGroupStart = Number(button.dataset.pageGroup);
        currentPage = expandedGroupStart;
        applyFilters(false, true);
      }));
      previousButtons.forEach((button) => button.addEventListener("click", () => {
        currentPage = Math.max(1, currentPage - 1);
        expandedGroupStart = groupStartForPage(currentPage);
        applyFilters(false, true);
      }));
      nextButtons.forEach((button) => button.addEventListener("click", () => {
        currentPage += 1;
        expandedGroupStart = groupStartForPage(currentPage);
        applyFilters(false, true);
      }));
    }
  </script>
</Layout>
