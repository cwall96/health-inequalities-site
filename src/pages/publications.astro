---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import { teamPublications, type Pub } from "../lib/publications";

const reader = createReader(process.cwd(), keystaticConfig);
const team = await reader.collections.team.all();
const settings = await reader.singletons.home.read();
const manualEntries = await reader.collections.publications.all();

const ids = team.map((t) => t.entry.identifier).filter(Boolean) as string[];

const manual: Pub[] = manualEntries.map((m) => ({
  title: m.entry.title,
  year: m.entry.year ?? null,
  doi: null,
  venue: m.entry.venue ?? "",
  citations: 0,
  authors: m.entry.authors ?? "",
  url: m.entry.url ?? null,
}));

const pubs = await teamPublications(ids, {
  hidden: (settings?.hiddenDois ?? []) as string[],
  manual,
});

const byYear = new Map<number, Pub[]>();
for (const p of pubs) {
  const y = p.year ?? 0;
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const firstAuthorSurname = (authors: string) => {
  const clean = authors.trim();
  if (!clean) return "";

  if (clean.includes(";")) {
    const firstAuthor = clean.split(";")[0].trim();
    if (firstAuthor.includes(",")) return firstAuthor.split(",")[0].trim();
    return firstAuthor.split(/\s+/).at(-1) ?? "";
  }

  const firstAuthor = clean.split(",")[0].trim();
  return firstAuthor.split(/\s+/).at(-1) ?? "";
};

const firstAuthors = [...new Set(pubs.map((p) => firstAuthorSurname(p.authors)).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b));
const journals = [...new Set(pubs.map((p) => p.venue.trim()).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b));

export const prerender = true;
---

<Layout title="Publications — Health Inequalities Team">
  <section class="section">
    <div class="container-page">
      <p class="eyebrow">Research outputs</p>
      <h1 class="mt-3">Publications</h1>
      <p class="mt-3 text-sm text-muted">Updated automatically from OpenAlex.</p>

      {
        pubs.length === 0 ? (
          <p class="mt-10 text-muted">
            No publications found yet. Add an ORCID (or OpenAlex ID) to each person in
            <code>/keystatic</code>, then rebuild.
          </p>
        ) : (
          <div class="mt-10" data-publication-filters>
            <form class="publication-filters" aria-label="Filter publications" onsubmit="return false">
              <div>
                <label for="publication-year">Publication year</label>
                <select id="publication-year" data-filter="year">
                  <option value="">All years</option>
                  {years.map((year) => <option value={String(year)}>{year || "Undated"}</option>)}
                </select>
              </div>

              <div>
                <label for="first-author">First author surname</label>
                <input
                  id="first-author"
                  type="search"
                  list="first-author-options"
                  placeholder="Type a surname"
                  autocomplete="off"
                  data-filter="author"
                />
                <datalist id="first-author-options">
                  {firstAuthors.map((author) => <option value={author} />)}
                </datalist>
              </div>

              <div>
                <label for="publication-journal">Journal</label>
                <input
                  id="publication-journal"
                  type="search"
                  list="journal-options"
                  placeholder="Type a journal"
                  autocomplete="off"
                  data-filter="journal"
                />
                <datalist id="journal-options">
                  {journals.map((journal) => <option value={journal} />)}
                </datalist>
              </div>

              <button type="button" class="filter-reset" data-filter-reset>Clear filters</button>
            </form>

            <p class="mt-5 text-sm text-muted" aria-live="polite" data-publication-count>
              Showing {pubs.length} publication{pubs.length === 1 ? "" : "s"}
            </p>

            <div class="mt-8 max-w-4xl">
            {years.map((year) => (
              <div class="mb-8" data-year-group>
                <p class="mb-2 text-xs tracking-wide text-cloud-400">{year || "Undated"}</p>
                {byYear.get(year)!.map((p) => (
                  <article
                    class="flex items-start justify-between gap-4 border-t border-line py-4"
                    data-publication
                    data-year={String(p.year ?? 0)}
                    data-first-author={firstAuthorSurname(p.authors).toLowerCase()}
                    data-journal={p.venue.trim().toLowerCase()}
                  >
                    <div>
                      <p class="leading-6 text-ink">{p.title}</p>
                      <p class="text-sm text-muted">
                        {[p.authors, p.venue].filter(Boolean).join(" · ")}
                        {p.citations > 0 && <span> · {p.citations} citations</span>}
                      </p>
                    </div>
                    {p.url && (
                      <a href={p.url} aria-label="Open publication">
                        <i class="ti ti-external-link text-lg text-muted" aria-hidden="true"></i>
                      </a>
                    )}
                  </article>
                ))}
              </div>
            ))}
            </div>

            <p class="filter-empty" data-filter-empty hidden>
              No publications match those filters. Try clearing one or more selections.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <script>
    const filterPanel = document.querySelector<HTMLElement>("[data-publication-filters]");

    if (filterPanel) {
      const controls = [...filterPanel.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-filter]")];
      const publications = [...filterPanel.querySelectorAll<HTMLElement>("[data-publication]")];
      const yearGroups = [...filterPanel.querySelectorAll<HTMLElement>("[data-year-group]")];
      const count = filterPanel.querySelector<HTMLElement>("[data-publication-count]");
      const empty = filterPanel.querySelector<HTMLElement>("[data-filter-empty]");
      const reset = filterPanel.querySelector<HTMLButtonElement>("[data-filter-reset]");

      const applyFilters = () => {
        const year = filterPanel.querySelector<HTMLSelectElement>("[data-filter='year']")?.value ?? "";
        const author = filterPanel.querySelector<HTMLInputElement>("[data-filter='author']")?.value.trim().toLowerCase() ?? "";
        const journal = filterPanel.querySelector<HTMLInputElement>("[data-filter='journal']")?.value.trim().toLowerCase() ?? "";
        let visible = 0;

        publications.forEach((publication) => {
          const matches =
            (!year || publication.dataset.year === year) &&
            (!author || publication.dataset.firstAuthor?.includes(author)) &&
            (!journal || publication.dataset.journal?.includes(journal));

          publication.hidden = !matches;
          if (matches) visible += 1;
        });

        yearGroups.forEach((group) => {
          group.hidden = !group.querySelector("[data-publication]:not([hidden])");
        });

        if (count) count.textContent = `Showing ${visible} publication${visible === 1 ? "" : "s"}`;
        if (empty) empty.hidden = visible !== 0;
      };

      controls.forEach((control) => control.addEventListener("input", applyFilters));
      reset?.addEventListener("click", () => {
        controls.forEach((control) => (control.value = ""));
        applyFilters();
        controls[0]?.focus();
      });
    }
  </script>
</Layout>
