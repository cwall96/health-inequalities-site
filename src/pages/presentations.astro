---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import ResearchPublications from "../components/ResearchPublications.astro";

const reader = createReader(process.cwd(), keystaticConfig);
const team = await reader.collections.team.all();
const teamBySlug = new Map(team.map((person) => [person.slug, person.entry.name]));
const linkedPeople = (slugs: readonly (string | null)[] = []) =>
  slugs.flatMap((slug) => {
    if (!slug) return [];
    const name = teamBySlug.get(slug);
    return name ? [{ slug, name }] : [];
  });

const impacts = (await reader.collections.impacts.all()).sort(
  (a, b) =>
    (a.entry.order ?? 0) - (b.entry.order ?? 0) ||
    (b.entry.year ?? 0) - (a.entry.year ?? 0)
);

const deepEndCommendation = await reader.collections.recognition.read("deep-end-nihr-impact-award-commendation");

export const prerender = true;
---

<Layout title="Public engagement — Health Inequalities Team">
  <section class="section page-intro-section">
    <div class="container-page-wide">
      <div class="page-intro presentation-page-intro ml-auto max-w-2xl text-right" data-reveal>
        <h1 class="mt-3">Public engagement</h1>

        <p class="page-intro-copy mt-4 text-lg leading-8">
          Explore the impact of the Health Inequalities Team’s work with communities, practitioners and policymakers, and browse our publications.
        </p>

        <a href="#publications" class="btn-secondary mt-6 inline-flex">
          Browse publications <span aria-hidden="true">↓</span>
        </a>
      </div>

      <section id="impact-highlights" class="mt-12 scroll-mt-24" aria-labelledby="impact-highlights-heading">
        <h2 id="impact-highlights-heading">Impact highlights</h2>
        {impacts.length > 0 && (
          <div id="public-policy-impact" class="engagement-section impact-feature-section mt-6">
            <div class="engagement-section-heading" data-reveal>
              <span class="engagement-section-icon impact-section-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32">
                  <path d="M6 25V14m8 11V9m8 16V5" />
                  <path d="m5 10 7-5 6 3 8-5" />
                  <path d="m21 3 5 .1-.8 4.9" />
                </svg>
              </span>
              <div>
                <p class="eyebrow">Beyond academia</p>
                <h3 class="text-2xl">Three public engagement case studies</h3>
                <p class="mt-3 max-w-2xl leading-7 text-muted">
                  We’ve selected three case studies that show how team members share evidence, work with partners and inform decisions beyond academia.
                </p>
              </div>
            </div>

            <div class="impact-story-grid mt-7">
              {impacts.map((impact, index) => (
                <article class="impact-story-card" id={`impact-${impact.slug}`} data-reveal-row>
                  <div class="impact-story-media">
                    {impact.entry.image ? (
                      <img src={impact.entry.image} alt="" class="impact-story-image" />
                    ) : (
                      <div class="impact-story-placeholder" aria-hidden="true">
                        <svg viewBox="0 0 48 48">
                          <path d="M9 38V22m10 16V15m10 23V9m10 29V5" />
                          <path d="m8 15 10-7 9 4 12-8" />
                        </svg>
                      </div>
                    )}
                    <span class="impact-story-number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <div class="impact-story-content">
                    <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
                      <span class="impact-year">{impact.entry.year}</span>
                      {impact.entry.relatedWork && <span class="text-muted">{impact.entry.relatedWork}</span>}
                    </div>
                    <h4 class="text-xl">{impact.entry.title}</h4>
                    <p class="impact-story-summary">{impact.entry.summary}</p>
                    {linkedPeople(impact.entry.teamMembers).length > 0 && (
                      <div class="content-people-links">
                        <span>Team</span>
                        <div>
                          {linkedPeople(impact.entry.teamMembers).map((person) => (
                            <a href={`/people/${person.slug}`}>{person.name}</a>
                          ))}
                        </div>
                      </div>
                    )}
                    {impact.entry.evidence && (
                      <div class="impact-evidence">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="m5 12 4 4L19 6" />
                        </svg>
                        <p><strong>Evidence:</strong> {impact.entry.evidence}</p>
                      </div>
                    )}
                    {impact.entry.link && (
                      <a href={impact.entry.link} class="impact-supporting-link" target="_blank" rel="noopener noreferrer">
                        View supporting evidence <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}

        {deepEndCommendation && (
          <div class="mt-8">
            <article class="mt-5 grid items-center gap-6 rounded-xl border border-line bg-navy-50 p-6 sm:grid-cols-[10rem_minmax(0,1fr)] sm:p-8">
              {deepEndCommendation.image && (
                <img src={deepEndCommendation.image} alt="The Deep End Research Team’s 2026 NIHR Impact Prize commendation trophy" class="w-full max-w-40 rounded-lg" loading="lazy" />
              )}
              <div>
                <p class="eyebrow">{deepEndCommendation.recipient}</p>
                <h3 class="mt-2 text-2xl">{deepEndCommendation.title}</h3>
                {deepEndCommendation.description && <p class="mt-3 max-w-2xl leading-7 text-muted">{deepEndCommendation.description}</p>}
                {deepEndCommendation.link && (
                  <a class="impact-supporting-link mt-4 inline-block" href={deepEndCommendation.link}>Read the NIHR announcement <span aria-hidden="true">→</span></a>
                )}
              </div>
            </article>
          </div>
        )}
      </section>
    </div>
  </section>

  <ResearchPublications />

</Layout>
