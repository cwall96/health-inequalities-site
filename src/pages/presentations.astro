---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import PresentationCard from "../components/PresentationCard.astro";

const reader = createReader(process.cwd(), keystaticConfig);
const team = await reader.collections.team.all();
const teamBySlug = new Map(team.map((person) => [person.slug, person.entry.name]));
const linkedPeople = (slugs: readonly (string | null)[] = []) =>
  slugs.flatMap((slug) => {
    if (!slug) return [];
    const name = teamBySlug.get(slug);
    return name ? [{ slug, name }] : [];
  });

const items = (await reader.collections.presentations.all()).sort(
  (a, b) => (b.entry.date ?? "").localeCompare(a.entry.date ?? "")
);

const sharingItems = items.filter((item) => item.entry.section !== "media");
const mediaItems = items.filter((item) => item.entry.section === "media");

const impacts = (await reader.collections.impacts.all()).sort(
  (a, b) =>
    (a.entry.order ?? 0) - (b.entry.order ?? 0) ||
    (b.entry.year ?? 0) - (a.entry.year ?? 0)
);

const recognition = (await reader.collections.recognition.all()).sort(
  (a, b) =>
    (a.entry.order ?? 0) - (b.entry.order ?? 0) ||
    (b.entry.year ?? 0) - (a.entry.year ?? 0)
);

const itemYear = (date?: string | null) => date?.slice(0, 4) || "undated";
const years = [...new Set(items.map((item) => itemYear(item.entry.date)))].sort(
  (a, b) => {
    if (a === "undated") return 1;
    if (b === "undated") return -1;
    return b.localeCompare(a);
  }
);

const itemsInYear = (year: string) =>
  items.filter((item) => itemYear(item.entry.date) === year).length;

export const prerender = true;
---

<Layout title="Engagement and Impact — Health Inequalities Team">
  <section class="section page-intro-section">
    <div class="mx-auto w-full max-w-7xl px-6">
      <div class="page-intro presentation-page-intro ml-auto max-w-2xl text-right">
        <h1 class="mt-3">Engagement &amp; Impact</h1>

        <p class="page-intro-copy mt-4 text-lg leading-8">
          Explore how the Health Inequalities Team shares research, engages with wider audiences and contributes to public and policy change.
        </p>

        <div class="mt-6 flex flex-wrap justify-end gap-x-6 gap-y-3 text-sm text-navy-800">
          <span class="inline-flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-red-700" aria-hidden="true"></span>
            Presentations
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="h-3 w-3 rounded-full border border-navy-900/20 bg-lavender" aria-hidden="true"></span>
            Posters
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-navy-700" aria-hidden="true"></span>
            Media coverage
          </span>
        </div>
      </div>

      <div class="output-gallery-layout mt-14" data-output-filters>
        <main class="engagement-sections">
          {sharingItems.length > 0 && (
            <section id="sharing-our-research" class="engagement-section" data-output-section>
              <h2>Sharing our research</h2>
              <p class="mt-4 max-w-2xl leading-7 text-muted">
                Presentations and posters through which the team shares emerging methods, findings and ideas.
              </p>

              <div class="engagement-card-grid mt-9">
                {sharingItems.map((item) => (
                  <PresentationCard
                    title={item.entry.title}
                    section={item.entry.section ?? "conference"}
                    date={item.entry.date}
                    venue={item.entry.venue}
                    authors={item.entry.authors}
                    link={item.entry.link}
                    coverImage={item.entry.coverImage}
                    teamMembers={linkedPeople(item.entry.teamMembers)}
                    detailHref={item.entry.section === "poster" ? `/presentations/${item.slug}` : null}
                  />
                ))}
              </div>
            </section>
          )}

          {mediaItems.length > 0 && (
            <section id="media-coverage" class="engagement-section" data-output-section>
              <h2>Media coverage</h2>
              <p class="mt-4 max-w-2xl leading-7 text-muted">
                Selected media contributions and coverage involving members of the Health Inequalities Team.
              </p>

              <div class="engagement-card-grid mt-9">
                {mediaItems.map((item) => (
                  <PresentationCard
                    title={item.entry.title}
                    section={item.entry.section ?? "media"}
                    date={item.entry.date}
                    venue={item.entry.venue}
                    authors={item.entry.authors}
                    link={item.entry.link}
                    coverImage={item.entry.coverImage}
                    teamMembers={linkedPeople(item.entry.teamMembers)}
                    detailHref={null}
                  />
                ))}
              </div>
            </section>
          )}

          {impacts.length > 0 && (
            <section id="public-policy-impact" class="engagement-section impact-feature-section">
              <div class="engagement-section-heading">
                <span class="engagement-section-icon impact-section-icon" aria-hidden="true">
                  <svg viewBox="0 0 32 32">
                    <path d="M6 25V14m8 11V9m8 16V5" />
                    <path d="m5 10 7-5 6 3 8-5" />
                    <path d="m21 3 5 .1-.8 4.9" />
                  </svg>
                </span>
                <div>
                  <p class="eyebrow">Beyond academia</p>
                  <h2>Public and policy impact</h2>
                  <p class="mt-4 max-w-2xl leading-7 text-muted">
                    Examples of how the team's research has contributed to change, influence or benefit beyond academia.
                  </p>
                </div>
              </div>

              <div class="impact-story-grid mt-9">
                {impacts.map((impact, index) => (
                  <article class="impact-story-card" id={`impact-${impact.slug}`}>
                    <div class="impact-story-media">
                      {impact.entry.image ? (
                        <img src={impact.entry.image} alt="" class="impact-story-image" />
                      ) : (
                        <div class="impact-story-placeholder" aria-hidden="true">
                          <svg viewBox="0 0 48 48">
                            <path d="M9 38V22m10 16V15m10 23V9m10 29V5" />
                            <path d="m8 15 10-7 9 4 12-8" />
                          </svg>
                        </div>
                      )}
                      <span class="impact-story-number" aria-hidden="true">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                    </div>
                    <div class="impact-story-content">
                      <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
                        <span class="impact-year">{impact.entry.year}</span>
                        {impact.entry.relatedWork && <span class="text-muted">{impact.entry.relatedWork}</span>}
                      </div>
                      <h3 class="mt-4 text-2xl">{impact.entry.title}</h3>
                      <p class="mt-4 leading-7 text-ink">{impact.entry.summary}</p>
                      {linkedPeople(impact.entry.teamMembers).length > 0 && (
                        <div class="content-people-links">
                          <span>Team</span>
                          <div>
                            {linkedPeople(impact.entry.teamMembers).map((person) => (
                              <a href={`/people/${person.slug}`}>{person.name}</a>
                            ))}
                          </div>
                        </div>
                      )}
                      {impact.entry.evidence && (
                        <div class="impact-evidence">
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m5 12 4 4L19 6" />
                          </svg>
                          <p><strong>Evidence:</strong> {impact.entry.evidence}</p>
                        </div>
                      )}
                      {impact.entry.link && (
                        <a href={impact.entry.link} class="impact-supporting-link" target="_blank" rel="noopener noreferrer">
                          View supporting evidence <span aria-hidden="true">↗</span>
                        </a>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}

        </main>

        {items.length > 0 && (
          <aside class="output-year-filter" aria-labelledby="output-year-heading">
            <p class="eyebrow">Filter the gallery</p>
            <h2 id="output-year-heading" class="mt-2 text-xl">Output year</h2>

            <div class="output-year-options">
              <button type="button" class="output-year-button is-active" data-year-filter="" aria-pressed="true">
                <span>All years</span>
                <span>{items.length}</span>
              </button>
              {years.map((year) => (
                <button type="button" class="output-year-button" data-year-filter={year} aria-pressed="false">
                  <span>{year === "undated" ? "Undated" : year}</span>
                  <span>{itemsInYear(year)}</span>
                </button>
              ))}
            </div>

            <p class="mt-4 text-sm text-muted" aria-live="polite" data-output-count>
              Showing all {items.length} outputs
            </p>
          </aside>
        )}
      </div>
    </div>
  </section>

  {recognition.length > 0 && (
    <section id="awards-recognition" class="recognition-feature-section recognition-full-width">
      <div class="container-page">
        <div class="engagement-section-heading">
          <span class="engagement-section-icon recognition-section-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32">
              <path d="M10 4h12v7a6 6 0 0 1-12 0V4Z" />
              <path d="M10 7H5v2a6 6 0 0 0 6 6m11-8h5v2a6 6 0 0 1-6 6M16 17v6m-5 5h10m-8-5h6" />
            </svg>
          </span>
          <div>
            <p class="eyebrow">Celebrating achievement</p>
            <h2>Awards and recognition</h2>
            <p class="recognition-section-copy mt-4 max-w-2xl leading-7">
              Recognition of the team's people, partnerships and contributions to research and public health.
            </p>
          </div>
        </div>

        <div class="recognition-list mt-9">
          {recognition.map((item, index) => (
            <article class="recognition-item" id={`award-${item.slug}`}>
              <div class="recognition-card-top">
                <span class={`recognition-icon recognition-icon-${(index % 3) + 1}`} aria-hidden="true">
                  {index % 3 === 0 ? (
                    <svg viewBox="0 0 32 32">
                      <path d="M10 4h12v7a6 6 0 0 1-12 0V4Z" />
                      <path d="M10 7H5v2a6 6 0 0 0 6 6m11-8h5v2a6 6 0 0 1-6 6M16 17v6m-5 5h10m-8-5h6" />
                    </svg>
                  ) : index % 3 === 1 ? (
                    <svg viewBox="0 0 32 32">
                      <circle cx="16" cy="13" r="8" />
                      <path d="m11 20-2 9 7-4 7 4-2-9" />
                      <path d="m16 8 1.5 3 3.5.5-2.5 2.5.6 3.5-3.1-1.7-3.1 1.7.6-3.5-2.5-2.5 3.5-.5L16 8Z" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 32 32">
                      <path d="m16 3 3.7 7.6 8.3 1.2-6 5.8 1.4 8.2-7.4-3.9-7.4 3.9 1.4-8.2-6-5.8 8.3-1.2L16 3Z" />
                    </svg>
                  )}
                </span>
                <p class="recognition-year">{item.entry.year}</p>
              </div>
              <div class="recognition-content">
                <h3>{item.entry.title}</h3>
                <p class="mt-2 text-sm text-muted">
                  {[item.entry.recipient, item.entry.awardingBody].filter(Boolean).join(" · ")}
                </p>
                {linkedPeople(item.entry.teamMembers).length > 0 && (
                  <div class="content-people-links">
                    <span>Recipient</span>
                    <div>
                      {linkedPeople(item.entry.teamMembers).map((person) => (
                        <a href={`/people/${person.slug}`}>{person.name}</a>
                      ))}
                    </div>
                  </div>
                )}
                {item.entry.description && <p class="mt-3 leading-7 text-ink">{item.entry.description}</p>}
                {item.entry.link && (
                  <a href={item.entry.link} class="mt-3 inline-block text-sm" target="_blank" rel="noopener noreferrer">
                    Find out more <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    const outputFilters = document.querySelector<HTMLElement>("[data-output-filters]");

    if (outputFilters) {
      const cards = [...outputFilters.querySelectorAll<HTMLElement>("[data-output-card]")];
      const sections = [...outputFilters.querySelectorAll<HTMLElement>("[data-output-section]")];
      const buttons = [...outputFilters.querySelectorAll<HTMLButtonElement>("[data-year-filter]")];
      const count = outputFilters.querySelector<HTMLElement>("[data-output-count]");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const selectedYear = button.dataset.yearFilter ?? "";
          let visible = 0;

          cards.forEach((card) => {
            const matches = !selectedYear || card.dataset.year === selectedYear;
            card.hidden = !matches;
            if (matches) visible += 1;
          });

          sections.forEach((section) => {
            section.hidden = !section.querySelector("[data-output-card]:not([hidden])");
          });

          buttons.forEach((yearButton) => {
            const isActive = yearButton === button;
            yearButton.classList.toggle("is-active", isActive);
            yearButton.setAttribute("aria-pressed", String(isActive));
          });

          if (count) {
            count.textContent = selectedYear
              ? `Showing ${visible} output${visible === 1 ? "" : "s"}`
              : `Showing all ${visible} outputs`;
          }
        });
      });
    }
  </script>
</Layout>
