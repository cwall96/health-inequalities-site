---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import PresentationCard from "../components/PresentationCard.astro";

const reader = createReader(process.cwd(), keystaticConfig);

const items = (await reader.collections.presentations.all()).sort(
  (a, b) =>
    (b.entry.date ?? "").localeCompare(a.entry.date ?? "")
);

export const prerender = true;
---

<Layout title="Presentations and posters — Health Inequalities Team">
  <section class="section">
    <div class="mx-auto w-full max-w-7xl px-6">
      <div class="ml-auto max-w-2xl text-right">
        <p class="eyebrow">
          Dissemination
        </p>

        <h1 class="mt-3">
          Presentations and posters
        </h1>

        <p class="mt-4 text-lg leading-8 text-muted">
          Explore presentations, posters and media coverage from the
          Health Inequalities Team.
        </p>

        <div class="mt-6 flex flex-wrap justify-end gap-x-6 gap-y-3 text-sm">
          <span class="inline-flex items-center gap-2 text-muted">
            <span
              class="h-3 w-3 rounded-full bg-red-700"
              aria-hidden="true"
            ></span>

            Presentations and posters
          </span>

          <span class="inline-flex items-center gap-2 text-muted">
            <span
              class="h-3 w-3 rounded-full bg-navy-700"
              aria-hidden="true"
            ></span>

            Media coverage
          </span>
        </div>
      </div>

      {
        items.length === 0 ? (
          <div class="mt-14 rounded-2xl border border-line bg-white p-8 text-center">
            <p class="text-muted">
              Nothing has been added yet. Add presentations, posters and
              media coverage in the editor at <code>/keystatic</code>.
            </p>
          </div>
        ) : (
          <div class="mt-14 grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
              items.map((item) => (
                <PresentationCard
                  title={item.entry.title}
                  section={item.entry.section ?? "conference"}
                  date={item.entry.date}
                  venue={item.entry.venue}
                  link={item.entry.link}
                  coverImage={item.entry.coverImage}
                />
              ))
            }
          </div>
        )
      }
    </div>
  </section>
</Layout>