---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);

const projects = (await reader.collections.projects.all()).sort(
  (a, b) =>
    (a.entry.order ?? 0) - (b.entry.order ?? 0) ||
    a.entry.title.localeCompare(b.entry.title)
);

const statusLabel = {
  ongoing: "Ongoing",
  completed: "Completed",
};
---

<Layout title="Projects — Health Inequalities Team">
  <section class="section">
    <div class="container-page">
      <p class="eyebrow">Our research</p>
      <h1 class="mt-3">Projects</h1>

      <p class="mt-5 max-w-2xl leading-7 text-muted">
        Explore our main research projects and collaborations addressing the
        causes and consequences of health inequalities.
      </p>

      {
        projects.length === 0 ? (
          <p class="mt-10 text-muted">
            No projects have been added yet.
          </p>
        ) : (
          <div class="mt-10 grid gap-6 md:grid-cols-2">
            {projects.map((project) => (
              <a
                href={`/projects/${project.slug}`}
                class="group block h-full no-underline"
              >
                <article class="card flex h-full flex-col overflow-hidden p-0 transition-shadow group-hover:shadow-pop">
                  {project.entry.coverImage && (
                    <img
                      src={project.entry.coverImage}
                      alt=""
                      class="h-52 w-full object-cover"
                    />
                  )}

                  <div class="flex flex-1 flex-col p-6">
                    <div class="flex flex-wrap items-center gap-3 text-xs">
                      <span class={`project-status project-status-${project.entry.status}`}>
                        {statusLabel[project.entry.status]}
                      </span>

                      {project.entry.timeframe && (
                        <span class="text-cloud-500">
                          {project.entry.timeframe}
                        </span>
                      )}
                    </div>

                    <h2 class="mt-4 text-2xl">
                      {project.entry.title}
                    </h2>

                    <p class="mt-3 flex-1 leading-7 text-muted">
                      {project.entry.summary}
                    </p>

                    <span class="mt-5 text-sm font-medium text-red-600">
                      View project →
                    </span>
                  </div>
                </article>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>