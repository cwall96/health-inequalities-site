---
interface Props {
  title: string;
  section: string;
  date?: string | null;
  venue?: string | null;
  link?: string | null;
  coverImage?: string | null;
}

const {
  title,
  section,
  date,
  venue,
  link,
  coverImage,
} = Astro.props;

const isMedia = section === "media";
const isPoster = section === "poster";
const isOnDark = !isPoster;

const typeLabel = isMedia
  ? "Media coverage"
  : isPoster
    ? "Poster"
    : "Presentation";

const actionLabel = isMedia
  ? "View coverage"
  : isPoster
    ? "View poster"
    : "View presentation";

const formattedDate = date
  ? new Date(date).toLocaleDateString("en-GB", {
      month: "long",
      year: "numeric",
    })
  : "";
const year = date?.slice(0, 4) || "undated";
---

<article
  data-output-card
  data-year={year}
  class:list={[
    "engagement-output-card group flex h-full flex-col overflow-hidden rounded-2xl shadow-card transition-all duration-200 hover:shadow-pop",
    isMedia ? "bg-navy-700" : isPoster ? "bg-lavender" : "bg-red-700",
  ]}
>
  {
    coverImage ? (
      <img
        src={coverImage}
        alt=""
        class:list={[
          "aspect-[4/3] w-full",
          isPoster
            ? "bg-lavender object-contain"
            : isMedia
              ? "bg-navy-800 object-cover"
              : "bg-surface object-contain",
        ]}
        loading="lazy"
      />
    ) : (
      <div
        class:list={[
          "flex aspect-[4/3] w-full items-center justify-center",
          isMedia ? "bg-navy-800" : isPoster ? "bg-navy-50" : "bg-red-800",
        ]}
        aria-hidden="true"
      >
        <span class:list={["text-lg font-medium", isOnDark ? "text-white/75" : "text-navy-800"]}>
          {typeLabel}
        </span>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-4">
      <span
        class:list={[
          "rounded-full px-3 py-1 text-xs font-medium uppercase tracking-wide",
          isOnDark ? "bg-white/15 text-white" : "bg-navy-900/10 text-navy-900",
        ]}
      >
        {typeLabel}
      </span>

      {
        formattedDate && (
          <time
            datetime={date ?? undefined}
            class:list={[
              "text-right text-sm",
              isOnDark ? "text-white/75" : "text-navy-800",
            ]}
          >
            {formattedDate}
          </time>
        )
      }
    </div>

    <h2 class:list={["mt-6 text-2xl leading-8", isOnDark ? "text-white" : "text-navy-900"]}>
      {title}
    </h2>

    {
      venue && (
        <p class:list={["mt-3 text-sm leading-6", isOnDark ? "text-white/75" : "text-navy-800"]}>
          {venue}
        </p>
      )
    }

    {
      link && (
        <a
          href={link}
          class:list={[
            "mt-auto inline-flex self-start rounded-full px-4 py-2 pt-2 text-sm font-medium no-underline transition-colors hover:no-underline",
            isOnDark
              ? "bg-surface text-navy-800 hover:bg-white"
              : "bg-navy-900 text-white hover:bg-navy-800",
          ]}
        >
          {actionLabel}

          <span
            class="ml-2 inline-block transition-transform group-hover:translate-x-1"
            aria-hidden="true"
          >
            →
          </span>
        </a>
      )
    }
  </div>
</article>
