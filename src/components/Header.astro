---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";

const path = Astro.url.pathname;
const reader = createReader(process.cwd(), keystaticConfig);

const [impactItems, recognitionItems] = await Promise.all([
  reader.collections.impacts.all(),
  reader.collections.recognition.all(),
]);

const links = [
  { href: "/", label: "Home" },
  { href: "/people", label: "People" },
  { href: "/research", label: "Research" },
  { href: "/presentations", label: "Engagement & Impact" },
  { href: "/publications", label: "Publications" },
  { href: "/news", label: "What's New?" },
];

const homeSectionLinks = [
  { href: "/#about-hit", label: "About HIT" },
  {
    href: "/#what-are-health-inequalities",
    label: "What are health inequalities?",
  },
];

const researchSectionLinks = [
  { href: "/research#research-programmes", label: "Research programmes" },
  { href: "/research#research-themes", label: "Research themes" },
  { href: "/research#studies-heading", label: "Studies" },
];

const engagementSectionLinks = [
  { href: "/presentations#sharing-our-research", label: "Presentations & posters" },
  { href: "/presentations#media-coverage", label: "Media coverage" },
  ...(impactItems.length > 0
    ? [{ href: "/presentations#public-policy-impact", label: "Public & policy impact" }]
    : []),
  ...(recognitionItems.length > 0
    ? [{ href: "/presentations#awards-recognition", label: "Awards & recognition" }]
    : []),
];

const sectionLinksFor = (href: string) => {
  if (href === "/") return homeSectionLinks;
  if (href === "/research") return researchSectionLinks;
  return engagementSectionLinks;
};

const isActive = (href: string) => {
  if (href === "/") return path === "/";

  if (href === "/research") {
    return ["/research", "/projects", "/studies"].some((route) =>
      path.startsWith(route)
    );
  }

  return path.startsWith(href);
};
---

<header class="site-header">
  <div class="container-page site-header-inner">
    <details class="mobile-menu">
      <summary class="mobile-menu-summary">
        <i class="ti ti-menu-2" aria-hidden="true"></i>
        <span>Menu</span>
      </summary>

      <nav class="mobile-navigation" aria-label="Mobile navigation">
        {
          links.map((link) => (
            <>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "mobile-nav-link",
                  { "mobile-nav-link-active": isActive(link.href) },
                ]}
              >
                {link.label}
              </a>

              {link.href === "/" && (
                <div class="mobile-subnavigation">
                  {homeSectionLinks.map((section) => (
                    <a href={section.href}>{section.label}</a>
                  ))}
                </div>
              )}

              {link.href === "/research" && (
                <div class="mobile-subnavigation">
                  {researchSectionLinks.map((section) => (
                    <a href={section.href}>{section.label}</a>
                  ))}
                </div>
              )}

              {link.href === "/presentations" && (
                <div class="mobile-subnavigation">
                  {engagementSectionLinks.map((section) => (
                    <a href={section.href}>{section.label}</a>
                  ))}
                </div>
              )}
            </>
          ))
        }
      </nav>
    </details>

    <nav class="site-navigation" aria-label="Main navigation">
      {
        links.map((link) =>
          link.href === "/" || link.href === "/research" || link.href === "/presentations" ? (
            <div class="site-nav-dropdown">
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                aria-haspopup="true"
                class:list={[
                  "site-nav-link site-nav-dropdown-trigger",
                  { "site-nav-link-active": isActive(link.href) },
                ]}
              >
                {link.label}
                <i class="ti ti-chevron-down" aria-hidden="true"></i>
              </a>

              <div class="site-subnavigation">
                {sectionLinksFor(link.href).map((section) => (
                  <a href={section.href}>{section.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "site-nav-link",
                { "site-nav-link-active": isActive(link.href) },
              ]}
            >
              {link.label}
            </a>
          )
        )
      }
    </nav>

    <a href="/" class="header-brand">
      <svg
        width="30"
        height="30"
        viewBox="0 0 30 30"
        aria-hidden="true"
      >
        <circle
          cx="15"
          cy="15"
          r="13"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        ></circle>

        <circle
          cx="15"
          cy="15"
          r="6.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        ></circle>

        <circle
          cx="15"
          cy="15"
          r="1.8"
          fill="currentColor"
        ></circle>

        <line
          x1="15"
          y1="0"
          x2="15"
          y2="30"
          stroke="currentColor"
          stroke-width="2"
        ></line>

        <line
          x1="0"
          y1="15"
          x2="30"
          y2="15"
          stroke="currentColor"
          stroke-width="2"
        ></line>
      </svg>

      <span>Health Inequalities Team</span>
    </a>
  </div>
</header>
