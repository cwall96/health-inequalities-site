---
const path = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/people", label: "People" },
  { href: "/research", label: "Research" },
  { href: "/presentations", label: "Presentations & Posters" },
  { href: "/publications", label: "Publications" },
  { href: "/news", label: "News" },
];

const isActive = (href: string) => {
  if (href === "/") return path === "/";

  if (href === "/research") {
    return ["/research", "/projects", "/studies"].some((route) =>
      path.startsWith(route)
    );
  }

  return path.startsWith(href);
};
---

<header class="site-header">
  <div class="container-page site-header-inner">
    <nav class="site-navigation" aria-label="Main navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "site-nav-link",
              { "site-nav-link-active": isActive(link.href) },
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a href="/" class="header-brand">
      <svg
        width="30"
        height="30"
        viewBox="0 0 30 30"
        aria-hidden="true"
      >
        <circle
          cx="15"
          cy="15"
          r="13"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        ></circle>

        <circle
          cx="15"
          cy="15"
          r="6.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        ></circle>

        <circle
          cx="15"
          cy="15"
          r="1.8"
          fill="currentColor"
        ></circle>

        <line
          x1="15"
          y1="0"
          x2="15"
          y2="30"
          stroke="currentColor"
          stroke-width="2"
        ></line>

        <line
          x1="0"
          y1="15"
          x2="30"
          y2="15"
          stroke="currentColor"
          stroke-width="2"
        ></line>
      </svg>

      <span>Health Inequalities Team</span>
    </a>
  </div>
</header>