---
interface Props {
  slug: string;
  name: string;
  role: string;
  category: string;
  photo?: string | null;
  email?: string | null;
  researchKeywords?: string | null;
}

const {
  slug,
  name,
  role,
  category,
  photo,
  email,
  researchKeywords,
} = Astro.props;

const initials = name
  .split(" ")
  .map((word) => word[0])
  .slice(0, 2)
  .join("");
---

<a
  href={`/people/${slug}`}
  data-category={category}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white no-underline transition-all duration-200 hover:-translate-y-1 hover:border-red-200 hover:shadow-pop focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-red-700"
  aria-label={`View ${name}'s profile`}
>
  {
    photo ? (
      <img
        src={photo}
        alt=""
        class="aspect-square w-full object-cover"
      />
    ) : (
      <span
        class="flex aspect-square w-full items-center justify-center bg-red-50 text-3xl font-medium text-red-700"
        aria-hidden="true"
      >
        {initials}
      </span>
    )
  }

  <div class="flex flex-1 flex-col p-4">
    <h2 class="text-xl text-ink">
      {name}
    </h2>

    <p class="mt-1 text-sm leading-6 text-muted">
      {role}
    </p>

    {
      email && (
        <p class="mt-3 break-words text-[13px] leading-5 tracking-tight text-red-700">
          {email}
        </p>
      )
    }

    {
      researchKeywords && (
        <p class="mt-4 text-sm leading-6 text-muted">
          <span class="font-medium text-ink">Research:</span>{" "}
          {researchKeywords}
        </p>
      )
    }

    <span class="mt-auto self-end pt-5">
      <span
        class="inline-flex items-center gap-1 rounded-full bg-red-700 px-4 py-2 text-sm font-medium text-white transition-colors group-hover:bg-red-800"
      >
        Profile

        <span
          aria-hidden="true"
          class="inline-block transition-transform group-hover:translate-x-1"
        >
          →
        </span>
      </span>
    </span>
  </div>
</a>