---
interface Props {
  currentStage?: string | null;
}

const { currentStage } = Astro.props;

const studyStages = [
  { value: "protocol", label: "Protocol" },
  { value: "ethical-approval", label: "Ethical approval" },
  { value: "study-setup", label: "Study set-up" },
  { value: "data-collection", label: "Data collection" },
  { value: "data-analysis", label: "Data analysis" },
  { value: "dissemination", label: "Dissemination" },
  { value: "concluded", label: "Concluded" },
] as const;

const currentStageIndex = Math.max(
  0,
  studyStages.findIndex((stage) => stage.value === currentStage)
);
---

<ol class="study-timeline-list">
  {studyStages.map((stage, index) => (
    <li
      class:list={[
        "study-timeline-step",
        {
          "is-complete": index < currentStageIndex,
          "is-current": index === currentStageIndex,
        },
      ]}
      aria-current={index === currentStageIndex ? "step" : undefined}
    >
      <span class="study-timeline-marker" aria-hidden="true"></span>
      <span>{stage.label}</span>
    </li>
  ))}
</ol>
