---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageControls from "../components/PageControls.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Health Inequalities Team — Newcastle University",
  description = "Research on how place shapes health, and what policy can do to close the gap.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Tabler icons (CDN for the starter; self-host @tabler/icons-webfont for production). -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/dist/tabler-icons.min.css"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
  </head>
  <body id="top">
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
    <Header />
    <PageControls />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const revealItems =
        document.querySelectorAll<HTMLElement>("[data-reveal]");
      const revealRowItems =
        document.querySelectorAll<HTMLElement>("[data-reveal-row]");
      const revealReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (revealReducedMotion || !("IntersectionObserver" in window)) {
        revealItems.forEach((item) => item.classList.add("is-revealed"));
        revealRowItems.forEach((item) => item.classList.add("is-revealed"));
      } else if (revealItems.length > 0 || revealRowItems.length > 0) {
        document.documentElement.classList.add("has-scroll-reveal");

        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-revealed");
              revealObserver.unobserve(entry.target);
            });
          },
          {
            threshold: 0.1,
            rootMargin: "0px 0px -7% 0px",
          }
        );

        revealItems.forEach((item) => revealObserver.observe(item));

        const rowRevealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              const item = entry.target as HTMLElement;
              const rowTop = item.offsetTop;
              const siblings = item.parentElement
                ? [...item.parentElement.querySelectorAll<HTMLElement>("[data-reveal-row]")]
                : [item];
              const row = siblings.filter(
                (sibling) => Math.abs(sibling.offsetTop - rowTop) < 3
              );

              row.forEach((rowItem) => {
                rowItem.classList.add("is-revealed");
                rowRevealObserver.unobserve(rowItem);
              });
            });
          },
          {
            threshold: 0.08,
            rootMargin: "0px 0px -5% 0px",
          }
        );

        revealRowItems.forEach((item) => rowRevealObserver.observe(item));
      }
    </script>
  </body>
</html>
